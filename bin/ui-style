#!/usr/bin/env python3
"""Compatibility command for Theme Engine UI-style profiles."""

from __future__ import annotations

import sys

import theme_runtime
import theme_ui


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in {"-h", "--help", "help"}:
        print("usage: ui-style [<name>|auto|current|list|new <name> [--from <base>]]")
        return 0
    name = theme_runtime.active_theme()
    try:
        theme = theme_runtime.load_theme(name) if name else None
        if args and args[0] == "new":
            if len(args) not in (2, 4) or (len(args) == 4 and args[2] != "--from"):
                print("usage: ui-style new <name> [--from <base>]", file=sys.stderr)
                return 2
            print(
                theme_ui.save_custom_profile(
                    args[1], args[3] if len(args) == 4 else "precision"
                )
            )
            return 0
        if args and args[0] in {"current", "status"}:
            args = []
        elif args and args[0] == "list":
            args = ["--list"]
        return theme_ui.command(args, theme, name)
    except (ValueError, TypeError, OSError) as exc:
        print(f"ui-style: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
