    info_color = r.get("info", r.get("ansi_blue", r["accent2"]))
    cfg = f'''# AUTO-GENERATED by `theme`
[global]
    font = {load_font() or "JetBrainsMono Nerd Font"} 10
    frame_width = {bw}
    frame_color = "{r['accent']}"
    corner_radius = {rad}
    separator_color = frame
    offset = 12x12
    padding = 12
    horizontal_padding = 12
    width = 340
    origin = top-right
    history_length = 50
    sticky_history = yes
    show_indicators = yes

[urgency_low]
    background = "{r.get('surface_0', r['bg_alt'])}"
    foreground = "{r['text_dim']}"
    frame_color = "{info_color}"

[urgency_normal]
    background = "{r.get('surface_0', r['bg'])}"
    foreground = "{r['text']}"
    frame_color = "{r['accent']}"

[urgency_critical]
    background = "{r.get('surface_0', r['bg'])}"
    foreground = "{r['text']}"
    frame_color = "{r['urgent']}"
    timeout = 0
'''
    write(path, cfg)


