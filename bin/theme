white = {q(r['ansi_br_white'])}
'''
    font = load_font()
    if font:
        toml += f'\n[font.normal]\nfamily = "{font}"\n'
    write(os.path.join(CFG, "alacritty", "theme-engine.toml"), toml)
    main_cfg = os.path.join(CFG, "alacritty", "alacritty.toml")
    ensure_import(main_cfg,
                  'general.import = ["~/.config/alacritty/theme-engine.toml"]',
                  "")


def gen_vscode(r, dark):
    """Merge only our color keys into VSCodium settings.json; keep the rest."""
    path = os.path.join(CFG, "VSCodium", "User", "settings.json")
    if not os.path.isdir(os.path.dirname(path)):
        return
    try:
        data = json.load(open(path)) if os.path.exists(path) else {}
    except (OSError, ValueError):
        return  # don't risk clobbering a settings file we can't parse
    backup_once(path)
    data["workbench.colorCustomizations"] = {
        "editor.background": r["bg"], "editor.foreground": r["text"],
        "editorCursor.foreground": r["accent"], "editor.selectionBackground": r["bg_alt"],
        "editorLineNumber.foreground": r["text_dim"],
        "editorLineNumber.activeForeground": r["accent"],
        "sideBar.background": r["bg_alt"], "sideBar.foreground": r["text"],
        "activityBar.background": r["bg_alt"], "activityBar.foreground": r["accent"],
        "statusBar.background": r["bg_alt"], "statusBar.foreground": r["text"],
        "titleBar.activeBackground": r["bg"], "titleBar.activeForeground": r["text"],
        "tab.activeBackground": r["bg"], "tab.activeForeground": r["accent"],
        "tab.inactiveBackground": r["bg_alt"], "tab.inactiveForeground": r["text_dim"],
        "focusBorder": r["accent"], "terminal.background": r["bg"],
        "terminal.foreground": r["text"],
    }
    write(path, json.dumps(data, indent=2))


def gen_qt(r, dark):
    """qt5ct/qt6ct color scheme + point Qt at it (Kate, Dolphin, Electrum, …)."""
    def hx(c):
        return "#ff" + c.lstrip("#")   # ARGB
    win, txt, base, hl = hx(r["bg_alt"]), hx(r["text"]), hx(r["bg"]), hx(r["accent"])
    btn, hlt, dim = hx(r["bg_alt"]), hx(r["bg"]), hx(r["text_dim"])
    # QPalette order qt5ct expects (20 roles)
    row = ", ".join([txt, btn, hx(r["bg_alt"]), hx(r["bg_alt"]), dim, dim, txt,
                     hx(r["text"]), txt, base, win, "#ff000000", hl, hlt,
                     hx(r["accent2"]), hx(r["accent2"]), hx(r["bg"]), txt, win, txt])
    scheme = f"[ColorScheme]\nactive_colors={row}\ninactive_colors={row}\ndisabled_colors={row}\n"
    wrote = False
    for qt in ("qt5ct", "qt6ct"):
        d = os.path.join(CFG, qt)
        if not os.path.isdir(d):
            continue
        sp = os.path.join(d, "colors", "ThemeEngine.conf")
        write(sp, scheme)
        conf = os.path.join(d, f"{qt}.conf")
        if os.path.exists(conf):
            backup_once(conf)
            txt_conf = open(conf).read()
            import re
            if "color_scheme_path" in txt_conf:
                txt_conf = re.sub(r"color_scheme_path=.*", f"color_scheme_path={sp}", txt_conf)
            else:
                txt_conf = txt_conf.replace("[Appearance]",
                    f"[Appearance]\ncolor_scheme_path={sp}\ncustom_palette=true", 1)
            write(conf, txt_conf)
        wrote = True
    return wrote


def _kde_rgb(c):     # "#1e1e2e" -> "30,30,46"
    c = c.lstrip("#")
    return f"{int(c[0:2],16)},{int(c[2:4],16)},{int(c[4:6],16)}"


# papirus-folders named colors -> a representative hex, for nearest-match
_PAPIRUS = {
    "black": "4d4d4d", "blue": "5294e2", "bluegrey": "607d8b", "breeze": "4d8bca",
    "brown": "8d6e63", "carmine": "b71c1c", "cyan": "00bcd4", "darkcyan": "00838f",
    "deeporange": "ff7043", "green": "66bb6a", "grey": "9e9e9e", "indigo": "5c6bc0",
    "magenta": "e91e63", "nordic": "81a1c1", "orange": "ff9800", "palebrown": "a1887f",
    "paleorange": "ffb74d", "pink": "f06292", "red": "e53935", "teal": "009688",
    "violet": "7e57c2", "white": "e0e0e0", "yellow": "ffb300",
}


def _papirus_color(hexstr):
    """Nearest papirus-folders color name to an accent hex (RGB distance)."""
    c = hexstr.lstrip("#")
    ar, ag, ab = int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16)
    def dist(v):
        return (int(v[0:2], 16) - ar) ** 2 + (int(v[2:4], 16) - ag) ** 2 + (int(v[4:6], 16) - ab) ** 2
    return min(_PAPIRUS, key=lambda name: dist(_PAPIRUS[name]))


def gen_kde(r, s, dark):
    """Plasma color scheme -> ~/.local/share/color-schemes + apply it."""
    K = _kde_rgb
    scheme = f'''[General]
ColorScheme=ThemeEngine
Name=ThemeEngine

[Colors:Window]
BackgroundNormal={K(r['bg'])}
ForegroundNormal={K(r['text'])}

[Colors:View]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}
DecorationFocus={K(r['accent'])}

[Colors:Button]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}

[Colors:Selection]
BackgroundNormal={K(r['accent'])}
ForegroundNormal={K(r['bg'])}

[Colors:Tooltip]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}

[Colors:Complementary]
BackgroundNormal={K(r['bg'])}
ForegroundNormal={K(r['text'])}

[WM]
activeBackground={K(r['bg_alt'])}
activeForeground={K(r['text'])}
inactiveBackground={K(r['bg'])}
inactiveForeground={K(r['text_dim'])}
'''
    write(os.path.join(HOME, ".local", "share", "color-schemes", "ThemeEngine.colors"), scheme)


def gen_oomox(r, s, dark):
    """Write an oomox preset by overriding the color keys of a COMPLETE base
    preset (so oomox's fallback graph never hits a missing key). Building +
    applying happens in reload() via the oomox-cli wrapper."""
    papirus = os.path.isdir("/usr/share/icons/Papirus")
    over = {
        "BG": h(r["bg"]), "FG": h(r["text"]),
        "ACCENT_BG": h(r["accent"]),
        "MENU_BG": h(r["bg_alt"]), "MENU_FG": h(r["text"]),
        "SEL_BG": h(r["accent"]), "SEL_FG": h(r["bg"]),
        "TXT_BG": h(r["bg_alt"]), "TXT_FG": h(r["text"]),
        "BTN_BG": h(r["bg_alt"]), "BTN_FG": h(r["text"]),
        "HDR_BTN_BG": h(r["bg"]), "HDR_BTN_FG": h(r["text"]),
        "GTK3_GENERATE_DARK": "True" if dark else "False",
        "ROUNDNESS": str(int(s.get("corner_radius", 8))),
        "GRADIENT": "0.0",
        "ICONS_STYLE": "papirus" if papirus else "archdroid",
        "ICONS_ARCHDROID": h(r["accent"]),
        "ICONS_LIGHT_FOLDER": h(r["accent"]), "ICONS_LIGHT": h(r["accent2"]),
        "ICONS_MEDIUM": h(r["accent"]), "ICONS_DARK": h(r["bg_alt"]),
    }
    # merge onto a complete base preset shipped with the oomox clone
    base_dict = {}
    for b in ("colors/Featured/Gigavolt", "colors/Retro/eboda17"):
        p = os.path.join(HOME, "oomox", b)
        if os.path.exists(p):
            for ln in open(p):
                ln = ln.strip()
                if "=" in ln and not ln.startswith("#"):
                    k, v = ln.split("=", 1)
                    base_dict[k] = v
            break
    base_dict.update(over)
    preset = "# AUTO-GENERATED by `theme`\n" + "".join(
        f"{k}={v}\n" for k, v in base_dict.items())
    write(os.path.join(CFG, "oomox", "colors", "theme-engine"), preset)


def gen_gtk(r, dark):
    """Non-invasive GTK recolor via @define-color overrides (fallback when oomox
    isn't used). Injected into gtk-3.0/gtk.css and gtk-4.0/gtk.css."""
    block = (
        "/* THEME-ENGINE-START */\n"
        f"@define-color theme_bg_color {r['bg']};\n"
        f"@define-color theme_base_color {r['bg_alt']};\n"
        f"@define-color theme_fg_color {r['text']};\n"
        f"@define-color theme_text_color {r['text']};\n"
        f"@define-color theme_selected_bg_color {r['accent']};\n"
        f"@define-color theme_selected_fg_color {r['bg']};\n"
        f"@define-color accent_color {r['accent']};\n"
        f"@define-color accent_bg_color {r['accent']};\n"
        "/* THEME-ENGINE-END */\n")
    for ver in ("gtk-3.0", "gtk-4.0"):
        path = os.path.join(CFG, ver, "gtk.css")
        old = open(path).read() if os.path.exists(path) else ""
        import re
        old = re.sub(r"/\* THEME-ENGINE-START \*/.*?/\* THEME-ENGINE-END \*/\n?",
                     "", old, flags=re.S)
        if os.path.exists(path):
            backup_once(path)
        write(path, block + old)


def gen_xfce(r):
    """xfce4-terminal color scheme (applied by xfce4-terminal on next open)."""
    pal = ";".join(r.get(k, r["text"]) for k in
                   ["ansi_black", "ansi_red", "ansi_green", "ansi_yellow",
                    "ansi_blue", "ansi_magenta", "ansi_cyan", "ansi_white",
                    "ansi_br_black", "ansi_br_red", "ansi_br_green", "ansi_br_yellow",
                    "ansi_br_blue", "ansi_br_magenta", "ansi_br_cyan", "ansi_br_white"])
    cfg = (f"[Configuration]\nColorForeground={r['text']}\nColorBackground={r['bg']}\n"
           f"ColorCursor={r['accent']}\nColorPalette={pal}\n")
    path = os.path.join(CFG, "xfce4", "terminal", "terminalrc")
    backup_once(path)   # preserve any existing xfce terminal config
    write(path, cfg)


def reload():
    # zsh has no live-reload hook for its prompt (unlike kitty's SIGUSR1) --
    # a new terminal/tab or `exec zsh` is needed to pick up gen_zsh's output.
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    def run(*c):
        try:
            subprocess.run(c, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            pass  # tool not installed / not running — reload is best-effort
    run("hyprctl", "reload")
    run("pkill", "-USR2", "-x", "waybar")  # waybar reloads config + css in place
    run("pkill", "-USR1", "-x", "kitty")   # kitty re-reads its config
    # hyprpaper has no live-reload IPC for the config file — restart it
    run("pkill", "-x", "hyprpaper")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.Popen(["hyprpaper"], env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run("dunstctl", "reload")               # dunst re-reads its config
    # live-reload any running nvim instances (best effort, via their sockets)
    theme_lua = os.path.join(CFG, "nvim", "lua", "generated_theme.lua")
    rt = env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        socks = [os.path.join(rt, f) for f in os.listdir(rt) if f.startswith("nvim.")]
    except OSError:
        socks = []
    for sock in socks:
        run("nvim", "--server", sock, "--remote-send",
            f"<C-\\><C-N>:luafile {theme_lua}<CR>")
    # homepage overlay: hot-reload colors if running
    if theme_homepage.is_running():
        run("eww", "reload", "--config", theme_homepage.EWW_DIR)
    # --- host desktop-environment apply (only if those targets are enabled) ---
    tg = load_targets()
    if "kde" in tg:
        # re-applying the SAME scheme name won't refresh (Plasma caches by
        # name) — bounce off a stock scheme first to force a reload.
        run("plasma-apply-colorscheme", "BreezeDark")
        run("plasma-apply-colorscheme", "ThemeEngine")
    if "oomox" in tg and shutil.which("oomox-cli"):
        preset = os.path.join(CFG, "oomox", "colors", "theme-engine")
        run("oomox-cli", preset)            # builds+installs oomox-theme-engine
        name = "oomox-theme-engine"
        # icons: recolor Papirus folders to the nearest accent color (oomox's
        # own icon recolor is unreliable) and use that as the icon theme.
        icon_name = "Papirus-Dark"
        try:
            # papirus-folders needs a writable copy — mirror the system Papirus
            # into ~/.local/share/icons once (user dir wins over /usr/share).
            udir = os.path.join(HOME, ".local", "share", "icons", icon_name)
            sysdir = os.path.join("/usr/share/icons", icon_name)
            if not os.path.isdir(udir) and os.path.isdir(sysdir):
                shutil.copytree(sysdir, udir)
            at = json.load(open(os.path.join(THEME_DIR, (active() or "") + ".json")))
            run("papirus-folders", "-C", _papirus_color(at["roles"]["accent"]),
                "-t", icon_name)
        except (OSError, ValueError, KeyError):
            pass
        # GTK/Cinnamon/XFCE also cache by theme NAME; the name is unchanged
        # between switches, so toggle to another theme then back to force a
        # re-read of the rebuilt files.
        def set_theme(schema, key, val):
            run("gsettings", "set", schema, key, val)
        def xf(prop, val):
            run("xfconf-query", "-c", "xsettings", "-p", prop, "-s", val)
        gtk_targets = [("org.gnome.desktop.interface", "gtk-theme"),
                       ("org.cinnamon.desktop.interface", "gtk-theme"),
                       ("org.mate.interface", "gtk-theme")]
        icon_targets = [("org.gnome.desktop.interface", "icon-theme"),
                        ("org.cinnamon.desktop.interface", "icon-theme"),
                        ("org.mate.interface", "icon-theme")]
        for schema, key in gtk_targets:
            set_theme(schema, key, "Adwaita"); set_theme(schema, key, name)
        set_theme("org.cinnamon.theme", "name", "cinnamon"); set_theme("org.cinnamon.theme", "name", name)
        for schema, key in icon_targets:
            set_theme(schema, key, "hicolor"); set_theme(schema, key, icon_name)
        xf("/Net/ThemeName", "Adwaita"); xf("/Net/ThemeName", name)
        xf("/Net/IconThemeName", "hicolor"); xf("/Net/IconThemeName", icon_name)
        # DE-agnostic path (KDE ignores gsettings): write GTK's own settings.ini
        # so GTK apps pick the theme + icons in ANY session on next launch.
        for ver in ("gtk-3.0", "gtk-4.0"):
            sp = os.path.join(CFG, ver, "settings.ini")
            lines, seen = [], set()
            if os.path.exists(sp):
                backup_once(sp)
                for ln in open(sp):
                    k = ln.split("=", 1)[0].strip()
                    if k == "gtk-theme-name":
                        ln = f"gtk-theme-name={name}\n"; seen.add(k)
                    elif k == "gtk-icon-theme-name":
                        ln = f"gtk-icon-theme-name={icon_name}\n"; seen.add(k)
                    lines.append(ln)
            if "[Settings]" not in "".join(lines):
                lines.insert(0, "[Settings]\n")
            if "gtk-theme-name" not in seen:
                lines.insert(1, f"gtk-theme-name={name}\n")
            if "gtk-icon-theme-name" not in seen:
                lines.insert(1, f"gtk-icon-theme-name={icon_name}\n")
            write(sp, "".join(lines))
        # KDE/Qt icon theme (Papirus, recolored above)
        run("kwriteconfig5", "--group", "Icons", "--key", "Theme", icon_name)
        run("kwriteconfig6", "--group", "Icons", "--key", "Theme", icon_name)
    if "firefox" in tg:
        run("pywalfox", "update")           # push palette to Firefox chrome+pages


def apply(name):
    path = os.path.join(THEME_DIR, name + ".json")
    if not os.path.exists(path):
        sys.exit(f"theme: unknown theme '{name}'. Try: theme --list")
    t = json.load(open(path))
    r, s, dark = t["roles"], t.get("style", {}), t.get("dark", True)
    if "shadow_color" in s and "shadow" not in r:
        r["shadow"] = s["shadow_color"]
    r = resolve_semantic_roles(r)
    tg = load_targets()
    shape_name = theme_effects.profile_shape()
    texture_name = theme_effects.profile_texture()
    anim_name = theme_effects.profile_anim()
    if "hypr" in tg:      gen_hypr(r, s, shape_name, texture_name, anim_name)
    if "waybar" in tg:    gen_waybar(r)
    if "kitty" in tg:     gen_kitty(r, s)
    if "starship" in tg:  gen_starship(r)
    if "zsh" in tg:       gen_zsh(r, s, dark)
    if "nvim" in tg:      gen_nvim(r, dark)
    if "wallpaper" in tg: gen_wallpaper(name)
    if "wofi" in tg:      gen_wofi(r, s)
    if "rofi" in tg:      gen_rofi(r, s)
    if "dunst" in tg:     gen_dunst(r, s)
    if "hyprlock" in tg:  gen_hyprlock(r, s)
    if "homepage" in tg:  gen_homepage(r, s, name, texture_name)
    if "obsidian" in tg:  gen_obsidian(r, dark, tg["obsidian"])
    if "firefox" in tg:   gen_firefox(r, dark)
    if "kde" in tg:       gen_kde(r, s, dark)
    if "oomox" in tg:     gen_oomox(r, s, dark)
    if "gtk" in tg:       gen_gtk(r, dark)
    if "xfce" in tg:      gen_xfce(r)
    if "alacritty" in tg: gen_alacritty(r, s)
    if "vscode" in tg:    gen_vscode(r, dark)
    if "qt" in tg:        gen_qt(r, dark)
    write(ACTIVE_FILE, name + "\n")
    reload()
    print(f"theme -> {name}  ({', '.join(k for k in tg)} regenerated)")


def font_cmd(args):
    """`theme font [family | --list]` — the font axis (independent of color)."""
    if args and args[0] == "--list":
        try:
            out = subprocess.check_output(["fc-list", ":", "family"], text=True)
            fams = sorted({f.split(",")[0].strip() for f in out.splitlines()})
            print("\n".join(fams))
        except (OSError, subprocess.CalledProcessError):
            print("fc-list not available")
        return
    if not args:
        print(load_font() or "(unset — apps keep their own font)"); return
    write(FONT_FILE, args[0].strip() + "\n")
    print(f"font -> {args[0]}")
    cur = active()
    if cur:
        apply(cur)          # re-apply current theme so the font propagates


def _axis_cmd(axis, args, validate, save_fn, list_fn, profile_fn):
    """Generic handler for shape/texture/anim subcommands."""
    if args and args[0] in ("-l", "--list"):
        print("\n".join(list_fn()))
        return
    if not args:
        cur = profile_fn()
        print(cur or "(none — using theme defaults)")
        return
    name = args[0]
    if name == "none":
        save_fn(None)
        print(f"{axis} -> none (using theme defaults)")
        cur = active()
        if cur:
            apply(cur)
        return
    if not validate(name):
        avail = ", ".join(list_fn())
        sys.exit(f"theme {axis}: unknown {axis} '{name}'. Available: {avail}")
    save_fn(name)
    print(f"{axis} -> {name}")
    cur = active()
    if cur:
        apply(cur)


def shape_cmd(args):
    _axis_cmd("shape", args, theme_effects.validate_shape,
              theme_effects.save_shape, theme_effects.list_shapes,
              theme_effects.profile_shape)


def texture_cmd(args):
    _axis_cmd("texture", args, theme_effects.validate_texture,
              theme_effects.save_texture, theme_effects.list_textures,
              theme_effects.profile_texture)


def anim_cmd(args):
    _axis_cmd("anim", args, theme_effects.validate_anim,
              theme_effects.save_anim, theme_effects.list_anims,
              theme_effects.profile_anim)


def effects_cmd(args):
    """Back-compat: `theme effects` maps to `theme texture`."""
    texture_cmd(args)


def homepage_cmd(args):
    """`theme homepage [on|off|restart|left|right]` — desktop homepage overlay."""
    if not args:
        hp = theme_homepage.profile()
        running = theme_homepage.is_running()
        if running:
            print(f"on ({hp['alignment']}-aligned)")
        else:
            print("off")
        return
    cmd = args[0]
    if cmd == "on":
        hp = theme_homepage.profile()
        hp["enabled"] = True
        theme_homepage.save(hp)
        cur = active()
        if cur:
            apply(cur)
        msg = theme_homepage.start()
        print(f"homepage -> {msg}")
        return
    if cmd == "off":
        hp = theme_homepage.profile()
        hp["enabled"] = False
        theme_homepage.save(hp)
        msg = theme_homepage.stop()
        print(f"homepage -> {msg}")
        return
    if cmd == "restart":
        theme_homepage.stop()
        cur = active()
        if cur:
            apply(cur)
        msg = theme_homepage.start()
        print(f"homepage -> {msg}")
        return
    if cmd in theme_homepage.VALID_ALIGNMENTS:
        hp = theme_homepage.profile()
        hp["alignment"] = cmd
        theme_homepage.save(hp)
        print(f"homepage alignment -> {cmd}")
        cur = active()
        if cur:
            apply(cur)
        if theme_homepage.is_running():
            theme_homepage.stop()
            theme_homepage.start()
        return
    sys.exit(f"theme homepage: unknown command '{cmd}'. Try: on, off, restart, left, right")


def tui():
    """Interactive TUI for picking theme, shape, texture, and anim with live preview."""
    import curses

    all_themes = themes()
    all_shapes = ["(none)"] + theme_effects.list_shapes()
    all_textures = ["(none)"] + theme_effects.list_textures()
    all_anims = ["(none)"] + theme_effects.list_anims()

    columns = [
        ("THEME", all_themes),
        ("SHAPE", all_shapes),
        ("TEXTURE", all_textures),
        ("ANIM", all_anims),
    ]

    cur_theme = active() or all_themes[0]
    cur_shape = theme_effects.profile_shape()
    cur_texture = theme_effects.profile_texture()
    cur_anim = theme_effects.profile_anim()

    sel = [
        all_themes.index(cur_theme) if cur_theme in all_themes else 0,
        all_shapes.index(cur_shape) if cur_shape in all_shapes else 0,
        all_textures.index(cur_texture) if cur_texture in all_textures else 0,
        all_anims.index(cur_anim) if cur_anim in all_anims else 0,
    ]
    orig = list(sel)
    col = 0

    def val(c, i):
        v = columns[c][1][i]
        return None if v == "(none)" else v

    def apply_current():
        t = val(0, sel[0]) or all_themes[0]
        sh = val(1, sel[1])
        tx = val(2, sel[2])
        an = val(3, sel[3])
        if sh is not None:
            theme_effects.save_shape(sh)
        else:
            theme_effects.save_shape(None)
        if tx is not None:
            theme_effects.save_texture(tx)
        else:
            theme_effects.save_texture(None)
        if an is not None:
            theme_effects.save_anim(an)
        else:
            theme_effects.save_anim(None)
        apply(t)

    def run(stdscr):
        nonlocal col
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
        curses.init_pair(2, curses.COLOR_CYAN, -1)
        curses.init_pair(3, curses.COLOR_GREEN, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)

        last_applied = None

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            col_w = max(20, w // 4)

            stdscr.addnstr(0, 0, " THEME PICKER — ←→ columns  ↑↓ select  Enter confirm  q cancel",
                          w - 1, curses.A_BOLD | curses.color_pair(4))

            current_key = tuple(sel)
            if current_key != last_applied:
                last_applied = current_key
                try:
                    apply_current()
                except Exception:
                    pass

            for ci, (label, items) in enumerate(columns):
                x = ci * col_w
                style = curses.A_BOLD | curses.color_pair(2) if ci == col else curses.A_BOLD
                if x < w:
                    stdscr.addnstr(2, x, label, min(col_w, w - x), style)

                max_rows = h - 4
                offset = max(0, sel[ci] - max_rows // 2)
                for row_i, idx in enumerate(range(offset, min(len(items), offset + max_rows))):
                    y = 3 + row_i
                    if y >= h:
                        break
                    item = items[idx]
                    if ci == col and idx == sel[ci]:
                        st = curses.color_pair(1) | curses.A_BOLD
                    elif idx == sel[ci]:
                        st = curses.color_pair(3)
                    else:
                        st = 0
                    if x < w:
                        stdscr.addnstr(y, x, f" {item:<{col_w - 2}}", min(col_w, w - x), st)

            stdscr.refresh()
            k = stdscr.getch()
            if k == ord("q") or k == 27:
                sel[:] = orig
                apply_current()
                return
            elif k == curses.KEY_RIGHT:
                col = min(col + 1, len(columns) - 1)
            elif k == curses.KEY_LEFT:
                col = max(col - 1, 0)
            elif k == curses.KEY_DOWN:
                sel[col] = min(sel[col] + 1, len(columns[col][1]) - 1)
            elif k == curses.KEY_UP:
                sel[col] = max(sel[col] - 1, 0)
            elif k in (curses.KEY_ENTER, 10, 13):
                return

    curses.wrapper(run)
    t = val(0, sel[0]) or all_themes[0]
    sh = val(1, sel[1])
    tx = val(2, sel[2])
    an = val(3, sel[3])
    parts = [f"theme={t}"]
    if sh: parts.append(f"shape={sh}")
    if tx: parts.append(f"texture={tx}")
    if an: parts.append(f"anim={an}")
    print(f"Applied: {', '.join(parts)}")


def main():
    args = sys.argv[1:]
    if args and args[0] == "starship":
        cur = active()
        if not cur:
            sys.exit("theme starship: no active theme")
        path = os.path.join(THEME_DIR, cur + ".json")
        if not os.path.exists(path):
            sys.exit(f"theme starship: active theme '{cur}' is unavailable")
        gen_starship(json.load(open(path))["roles"])
        print(f"starship -> {cur}")
        return
    if args and args[0] == "shape":
        shape_cmd(args[1:]); return
    if args and args[0] == "texture":
        texture_cmd(args[1:]); return
    if args and args[0] == "anim":
        anim_cmd(args[1:]); return
    if args and args[0] == "effects":
        effects_cmd(args[1:]); return
    if args and args[0] == "homepage":
        homepage_cmd(args[1:]); return
    if args and args[0] == "font":
        font_cmd(args[1:]); return
    if args and args[0] in ("-l", "--list"):
        print("\n".join(themes())); return
    if not args:
        tui(); return
    apply(args[0])


if __name__ == "__main__":
    main()
