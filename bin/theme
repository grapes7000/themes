#!/usr/bin/env python3
"""theme — one command to re-skin the whole desktop.

    theme                 # TUI picker (interactive)
    theme <name>          # switch: regenerate hypr/waybar/kitty/starship + reload
    theme --list          # bare list, one per line
    theme shape           # show active shape
    theme shape <name>    # switch shape (sharp/rounded/pillowy/boxy)
    theme shape --list    # list available shapes
    theme shape none      # clear shape, use theme defaults
    theme texture         # show active texture
    theme texture <name>  # switch texture (clear/frosted/glaze/haze/bloom)
    theme texture --list  # list available textures
    theme texture none    # clear texture, use theme defaults
    theme anim            # show active animation style
    theme anim <name>     # switch anim (none/subtle/smooth/snappy/bouncy/dramatic/glitch)
    theme anim --list     # list available anims
    theme anim none       # clear anim, use theme defaults
    theme effects         # (back-compat) show active texture
    theme homepage        # show homepage status
    theme homepage on     # enable + start the desktop homepage overlay
    theme homepage off    # disable + stop the overlay
    theme homepage restart
    theme homepage left|right  # set alignment

Single source of truth: ~/.config/hypr/themes/<name>.json
Everything under */generated/ is written by this script — never edit it by hand.
"""
import json, os, sys, glob, subprocess, signal, shutil, time, re
from theme_starship import render as render_starship
import theme_effects
import theme_homepage

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CFG, "hypr", "themes")
ACTIVE_FILE = os.path.join(CFG, "hypr", "generated", ".active")
TARGETS_FILE = os.path.join(CFG, "theme-engine", "targets.conf")
FONT_FILE = os.path.join(CFG, "theme-engine", "font")

# Generators that run by default when no targets.conf exists (back-compat).
CORE_TARGETS = ["hypr", "waybar", "kitty", "starship", "nvim", "wallpaper"]


def load_font():
    """The user's chosen UI font (via `theme font <name>`), or '' if unset.
    When unset, font-bearing generators leave each app's own font alone."""
    try:
        return open(FONT_FILE).read().strip()
    except OSError:
        return ""


def load_targets():
    """Return {target: value} of enabled generators. `value` is True for a bare
    line, or a string for `target=value` (e.g. an Obsidian vault path)."""
    if not os.path.exists(TARGETS_FILE):
        return {t: True for t in CORE_TARGETS}
    out = {}
    for raw in open(TARGETS_FILE):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            out[k.strip()] = os.path.expanduser(v.strip())
        else:
            out[line] = True
    return out


def backup_once(path):
    """Copy path to path.bak-<ts> the first time we ever touch it."""
    if os.path.exists(path) and not glob.glob(path + ".bak-*"):
        shutil.copy2(path, path + ".bak-" + str(int(time.time())))


def ensure_import(path, import_line, default=""):
    """Guarantee import_line is the first line of the file at path (creating it
    with `default` if absent). Backs up an existing file once. Returns nothing."""
    exists = os.path.exists(path)
    content = open(path).read() if exists else ""
    if import_line in content:
        return
    if exists:
        backup_once(path)
    else:
        content = default
    write(path, import_line + "\n" + content)


def themes():
    return sorted(os.path.splitext(os.path.basename(p))[0]
                  for p in glob.glob(os.path.join(THEME_DIR, "*.json")))


def active():
    try:
        return open(ACTIVE_FILE).read().strip()
    except OSError:
        return None


def h(c):            # "#1e1e2e" -> "1e1e2e"
    return c.lstrip("#")


def a(op):           # 0.4 -> "66"  (alpha hex byte)
    return format(max(0, min(255, int(round(float(op) * 255)))), "02x")


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


# ── Color helpers (pure, deterministic) ──────────────────────────────

def hex_to_rgb(c):
    c = c.lstrip("#")
    return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))


def rgb_to_hex(r, g, b):
    return "#{:02x}{:02x}{:02x}".format(
        max(0, min(255, int(round(r)))),
        max(0, min(255, int(round(g)))),
        max(0, min(255, int(round(b)))),
    )


def blend(c1, c2, ratio):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    t = max(0.0, min(1.0, ratio))
    return rgb_to_hex(r1 + (r2 - r1) * t, g1 + (g2 - g1) * t, b1 + (b2 - b1) * t)


def with_alpha(color, alpha):
    return f"rgba({h(color)}{a(alpha)})"


def _relative_luminance(c):
    r, g, b = (v / 255.0 for v in hex_to_rgb(c))
    r = r / 12.92 if r <= 0.04045 else ((r + 0.055) / 1.055) ** 2.4
    g = g / 12.92 if g <= 0.04045 else ((g + 0.055) / 1.055) ** 2.4
    b = b / 12.92 if b <= 0.04045 else ((b + 0.055) / 1.055) ** 2.4
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(c1, c2):
    l1 = _relative_luminance(c1)
    l2 = _relative_luminance(c2)
    lighter = max(l1, l2)
    darker = min(l1, l2)
    return (lighter + 0.05) / (darker + 0.05)


def best_contrast(bg, candidates):
    return max(candidates, key=lambda c: contrast_ratio(bg, c))


# ── Semantic role resolver ───────────────────────────────────────────

def resolve_semantic_roles(roles):
    """Derive semantic desktop roles from the 9 core roles.
    Existing explicit values are preserved; missing ones get fallbacks."""
    r = dict(roles)
    bg = r["bg"]
    bg_alt = r.get("bg_alt", bg)
    text = r["text"]
    text_dim = r.get("text_dim", text)
    accent = r.get("accent", text)
    accent2 = r.get("accent2", accent)
    urgent = r.get("urgent", accent)
    focus = r.get("focus", accent)
    border_normal = r.get("border_normal", bg_alt)

    defaults = {
        "surface_0":     bg,
        "surface_1":     bg_alt,
        "surface_2":     blend(bg_alt, text, 0.08),
        "overlay":       bg,
        "hover":         blend(bg_alt, accent, 0.15),
        "selected":      accent,
        "border_subtle": border_normal,
        "border_strong": focus,
        "success":       r.get("ansi_green", accent2),
        "warning":       r.get("ansi_yellow", accent2),
        "info":          r.get("ansi_blue", accent2),
        "disabled":      text_dim,
        "shadow":        "#000000",
        "on_accent":     best_contrast(accent, [bg, text]),
        "on_urgent":     best_contrast(urgent, [bg, text]),
    }
    for key, fallback in defaults.items():
        if key not in r:
            r[key] = fallback
    return r


def gen_hypr(r, s, shape_name=None, texture_name=None, anim_name=None):
    s = theme_effects.resolve(s, shape_name, texture_name)
    blur_on = str(s.get("blur_on", "true")).lower() == "true"
    shadow_on = str(s.get("shadow_on", "true")).lower() == "true"
    gaps = int(s.get("gaps", 8))
    lines = [
        "# AUTO-GENERATED by `theme`. Edit hypr/themes/<name>.json instead.",
        f"$bg = rgb({h(r['bg'])})",
        f"$bg_alt = rgb({h(r['bg_alt'])})",
        f"$fg = rgb({h(r['text'])})",
        f"$fg_dim = rgb({h(r['text_dim'])})",
        f"$accent = rgb({h(r['accent'])})",
        f"$accent2 = rgb({h(r['accent2'])})",
        f"$urgent = rgb({h(r['urgent'])})",
        "",
        f"$group_active = rgb({h(r['accent'])})",
        f"$group_inactive = rgb({h(r.get('surface_1', r['bg_alt']))})",
        f"$group_locked = rgb({h(r.get('warning', r.get('ansi_yellow', r['accent2'])))})",
        f"$group_text = rgb({h(r.get('on_accent', r['bg']))})",
        "",
        "general {",
        f"    border_size = {int(s.get('border_width', 2))}",
        f"    gaps_in = {max(0, gaps // 2)}",
        f"    gaps_out = {gaps}",
        f"    col.active_border = rgba({h(r['focus'])}ff) rgba({h(r['accent2'])}ff) 45deg",
        f"    col.inactive_border = rgba({h(r['border_normal'])}aa)",
        "}",
        "",
        "decoration {",
        f"    rounding = {int(s.get('corner_radius', 10))}",
        f"    rounding_power = {float(s.get('rounding_power', 2.0))}",
        f"    active_opacity = {float(s.get('opacity', 1.0))}",
        f"    inactive_opacity = {float(s.get('opacity_inactive', 1.0))}",
        f"    dim_inactive = {'true' if float(s.get('inactive_dim', 0)) > 0 else 'false'}",
        f"    dim_strength = {float(s.get('inactive_dim', 0))}",
        "    blur {",
        f"        enabled = {'true' if blur_on else 'false'}",
        f"        size = {int(s.get('blur_strength', 8))}",
        f"        passes = {int(s.get('blur_passes', 3))}",
        f"        noise = {float(s.get('blur_noise', 0.0117))}",
        f"        contrast = {float(s.get('blur_contrast', 0.8916))}",
        f"        brightness = {float(s.get('blur_brightness', 0.8172))}",
        f"        vibrancy = {float(s.get('blur_vibrancy', 0.1696))}",
        "        new_optimizations = true",
        "        xray = false",
        "    }",
        "    shadow {",
        f"        enabled = {'true' if shadow_on else 'false'}",
        f"        range = {int(s.get('shadow_radius', 20))}",
        f"        render_power = {int(s.get('shadow_render_power', 3))}",
        f"        offset = {s.get('shadow_offset', '0 0')}",
        f"        color = rgba({h(s.get('shadow_color', '#000000'))}{a(s.get('shadow_opacity', 0.4))})",
        "    }",
        "}",
    ]
    if s.get("bar_blur"):
        for ns in ("waybar", "wofi", "rofi"):
            lines.extend([
                "",
                "layerrule {",
                f"    name = {ns}-blur",
                f"    match:namespace = {ns}",
                "    blur = yes",
                "}",
            ])
    lines.extend(theme_effects.render_animations(anim_name))
    write(os.path.join(CFG, "hypr", "generated", "theme.conf"), "\n".join(lines) + "\n")


def gen_waybar(r):
    keys = [
        "bg", "bg_alt", "text", "text_dim", "accent", "accent2", "urgent", "focus",
        "surface_0", "surface_1", "surface_2", "overlay", "hover", "selected",
        "border_subtle", "border_strong", "success", "warning", "info",
        "disabled", "on_accent", "on_urgent",
    ]
    css = "/* AUTO-GENERATED by `theme` */\n" + "".join(
        f"@define-color {k} {r[k]};\n" for k in keys if k in r)
    write(os.path.join(CFG, "waybar", "generated", "theme.css"), css)


def gen_kitty(r, s):
    """Colors + visual UI only (no font_size, no keybinds). Font is applied
    only if the user set one via `theme font`. The generated file is included
    at the END of the user's kitty.conf so their settings stay and colors win."""
    m = [("background", r["bg"]), ("foreground", r["text"]),
         ("cursor", r.get("cursor", r["accent"])),
         ("cursor_text_color", r["bg"]),
         ("selection_background", r.get("sel_bg", r["accent"])),
         ("selection_foreground", r.get("sel_fg", r["bg"])),
         ("url_color", r["accent2"]),
         ("active_border_color", r["accent"]),
         ("inactive_border_color", r["bg_alt"]),
         ("active_tab_background", r["accent"]),
         ("active_tab_foreground", r["bg"]),
         ("inactive_tab_background", r["bg_alt"]),
         ("inactive_tab_foreground", r["text_dim"])]
    ansi = ["ansi_black", "ansi_red", "ansi_green", "ansi_yellow", "ansi_blue",
            "ansi_magenta", "ansi_cyan", "ansi_white", "ansi_br_black", "ansi_br_red",
            "ansi_br_green", "ansi_br_yellow", "ansi_br_blue", "ansi_br_magenta",
            "ansi_br_cyan", "ansi_br_white"]
    out = "# AUTO-GENERATED by `theme` — colors + UI only (not your settings)\n"
    out += "".join(f"{k:24}{v}\n" for k, v in m)
    out += f"background_opacity {float(s.get('opacity', 1.0))}\n"
    font = load_font()
    if font:
        out += f"font_family {font}\n"
    for i, key in enumerate(ansi):
        out += f"color{i:<2} {r.get(key, r['text'])}\n"
    write(os.path.join(CFG, "kitty", "generated", "theme.conf"), out)
    # ensure the user's kitty.conf pulls this in (appended at the END, last-wins)
    kc = os.path.join(CFG, "kitty", "kitty.conf")
    inc = "include generated/theme.conf"
    if os.path.exists(kc):
        if inc not in open(kc).read():
            backup_once(kc)
            with open(kc, "a") as f:
                f.write(f"\n# theme-engine colors (managed by `theme`)\n{inc}\n")
    else:
        write(kc, f"# theme-engine colors (managed by `theme`)\n{inc}\n")


def gen_wallpaper(name):
    """Point hyprpaper at ~/.config/<name>/wallpaper.png if it exists,
    else fall back to ~/.config/hypr/wallpaper.png. Returns the path used."""
    # prefer a wallgen "blurry blob" wallpaper, then ~/.config/<name>/, then default
    generated = os.path.join(CFG, "hypr", "wallpapers", name + ".png")
    cand = os.path.join(CFG, name, "wallpaper.png")
    default = os.path.join(CFG, "hypr", "wallpaper.png")
    wp = next((p for p in (generated, cand, default) if os.path.exists(p)), default)
    write(os.path.join(CFG, "hypr", "hyprpaper.conf"),
          f"preload = {wp}\nwallpaper = , {wp}\nsplash = false\n")
    return wp


def _starship_color(key, r):
    """Map a palette color KEY name to a theme color (by keyword in the name)."""
    k = key.lower()
    def has(*w):
        return any(x in k for x in w)
    if has("deep", "dark", "bg", "back", "base", "night"):     return r["bg_alt"]
    if has("fg", "text", "white", "cream", "snow"):            return r["text"]
    if has("grey", "gray", "dim", "muted", "subtle"):          return r["text_dim"]
    if has("red", "hot", "crimson", "error", "urgent", "danger"): return r["urgent"]
    if has("lime", "green", "mint"):                           return r.get("ansi_green", r["accent2"])
    if has("yellow", "gold", "butter", "amber", "sand"):       return r.get("ansi_yellow", r["accent"])
    if has("orange", "peach", "tanger"):                       return r.get("ansi_yellow", r["accent"])
    if has("cyan", "teal", "foam", "aqua", "sky-blue"):        return r.get("ansi_cyan", r["accent2"])
    if has("blue", "azure", "sky", "ocean"):                   return r.get("ansi_blue", r["accent2"])
    if has("pink", "magenta", "rose", "mauve", "soft", "pale", "blush"): return r.get("ansi_magenta", r["accent"])
    if has("purple", "violet", "lavender", "lilac", "grape"):  return r["accent"]
    return r["accent"]


def gen_starship(r):
    """Fresh install -> our own prompt. If the user has a HAND-MADE prompt,
    follow the theme non-destructively: rewrite only the color VALUES inside
    [palettes.*] blocks, keeping their format, modules and structure."""
    path = os.path.join(CFG, "starship.toml")
    existing = open(path).read() if os.path.exists(path) else ""
    legacy_layout = ('format = "$directory$git_branch$git_status$character"' in existing
                     and 'symbol = " "' in existing
                     and 'style = "bold accent2"' in existing)
    if existing and "AUTO-GENERATED by `theme`" not in existing and not legacy_layout:
        import re
        backup_once(path)
        out, in_pal = [], False
        for ln in existing.splitlines(True):
            s = ln.strip()
            if s.startswith("[palettes."):
                in_pal = True; out.append(ln); continue
            if s.startswith("[") and not s.startswith("[palettes."):
                in_pal = False
            if in_pal:
                m = re.match(r'(\s*)([A-Za-z0-9_\-]+)(\s*=\s*)"#?[0-9A-Fa-f]{6}"(.*)', ln)
                if m:
                    ln = f'{m.group(1)}{m.group(2)}{m.group(3)}"{_starship_color(m.group(2), r)}"{m.group(4)}\n'
            out.append(ln)
        write(path, "".join(out))
        return
    toml = f'''# AUTO-GENERATED by `theme`
"$schema" = 'https://starship.rs/config-schema.json'
format = """\
[](fg:edge)[](fg:accent bg:edge)\
$directory\
${{custom.git_connector}}$git_branch$git_state$git_status${{custom.git_end}}${{custom.path_end}}\
$line_break\
$cmd_duration$jobs$character"""
add_newline = false
palette = "theme"

[palettes.theme]
bg = "{r['bg_alt']}"
fg = "{r['text']}"
accent = "{r['accent']}"
accent2 = "{r['accent2']}"
edge = "{r['text_dim']}"
urgent = "{r['urgent']}"

[directory]
format = "[ 󰉋  $path ]($style)"
style = "bold fg:bg bg:accent"
truncation_length = 6
truncate_to_repo = true

[custom.git_connector]
command = "printf x"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
format = "[](fg:accent bg:accent2)"

[custom.git_end]
command = "printf x"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
format = "[](fg:accent2 bg:bg)"

[custom.path_end]
command = "printf x"
when = "! git rev-parse --is-inside-work-tree >/dev/null 2>&1"
format = "[](fg:accent bg:bg)"

[git_branch]
symbol = " "
format = "[$symbol$branch ]($style)"
style = "bold fg:bg bg:accent2"

[git_state]
format = "[󰘬 $state( $progress_current/$progress_total) ]($style)"
style = "bold fg:urgent bg:accent2"

[git_status]
format = "([$all_status$ahead_behind ]($style))"
style = "bold fg:urgent bg:accent2"
conflicted = "=${{count}} "
ahead = "⇡${{count}} "
behind = "⇣${{count}} "
diverged = "⇕⇡${{ahead_count}}⇣${{behind_count}} "
untracked = "?${{count}} "
stashed = "≡${{count}} "
modified = "~${{count}} "
staged = "+${{count}} "
renamed = "»${{count}} "
deleted = "✘${{count}} "

[cmd_duration]
min_time = 2_000
format = "[󰔛 $duration ](bold accent2)"

[jobs]
symbol = "󰜎 "
format = "[$symbol$number ](bold accent2)"

[character]
success_symbol = "[❯](bold accent)"
error_symbol = "[❯](bold urgent)"
vimcmd_symbol = "[❮](bold accent2)"
'''
    write(path, render_starship(r))


def gen_zsh(r, s, dark):
    """oh-my-zsh custom theme from the palette. Skips silently if oh-my-zsh
    isn't installed. Only switches ZSH_THEME the first time (afterwards just
    updates this theme file's colors, so a user who later picks a different
    ZSH_THEME isn't fought on every `theme` run)."""
    omz = os.path.join(HOME, ".oh-my-zsh")
    if not os.path.isdir(omz):
        return
    theme_file = os.path.join(omz, "custom", "themes", "theme-engine.zsh-theme")
    first_time = not os.path.exists(theme_file)
    content = f'''# AUTO-GENERATED by `theme` — colors only, safe to fork
PROMPT='%F{{{r["accent"]}}}%~%f %F{{{r["accent2"]}}}$(git_prompt_info)%f%(?.. %F{{{r["urgent"]}}}✗%f)%F{{{r["accent"]}}} ❯%f '
ZSH_THEME_GIT_PROMPT_PREFIX="%F{{{r["text_dim"]}}}git:(%F{{{r["accent2"]}}}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%F{{{r["text_dim"]}}})%f "
ZSH_THEME_GIT_PROMPT_DIRTY="%F{{{r["urgent"]}}}*%f"
ZSH_THEME_GIT_PROMPT_CLEAN=""
'''
    write(theme_file, content)
    if first_time:
        zshrc = os.path.join(HOME, ".zshrc")
        if os.path.exists(zshrc):
            existing = open(zshrc).read()
            if 'ZSH_THEME="theme-engine"' not in existing:
                backup_once(zshrc)
                import re
                new, n = re.subn(r'^ZSH_THEME=.*$', 'ZSH_THEME="theme-engine"',
                                  existing, count=1, flags=re.M)
                if n == 0:
                    new = 'ZSH_THEME="theme-engine"\n' + existing
                write(zshrc, new)


def gen_nvim(r, dark):
    """Generate a Neovim colorscheme from the palette (works for every theme,
    including custom ones). Written to ~/.config/nvim/lua/generated_theme.lua
    and self-applied when required."""
    def g(k, d="text"):
        return r.get(k, r[d])
    c = {
        "bg": r["bg"], "bg_alt": r["bg_alt"], "fg": r["text"], "dim": r["text_dim"],
        "sel": r.get("border_normal", r["bg_alt"]), "line": r.get("ansi_br_black", r["bg_alt"]),
        "accent": r["accent"], "accent2": r["accent2"], "urgent": r["urgent"],
        "red": g("ansi_red", "urgent"), "green": g("ansi_green"), "yellow": g("ansi_yellow"),
        "blue": g("ansi_blue"), "magenta": g("ansi_magenta"), "cyan": g("ansi_cyan"),
    }
    # (group, fg, bg, extra) — extra is a comma-separated style string or ""
    groups = [
        ("Normal", "fg", "bg", ""), ("NormalFloat", "fg", "bg_alt", ""),
        ("Comment", "dim", None, "italic"), ("Constant", "cyan", None, ""),
        ("String", "green", None, ""), ("Character", "green", None, ""),
        ("Number", "accent2", None, ""), ("Boolean", "accent2", None, ""),
        ("Float", "accent2", None, ""), ("Identifier", "fg", None, ""),
        ("Function", "blue", None, ""), ("Statement", "accent", None, ""),
        ("Keyword", "accent", None, "italic"), ("Conditional", "accent", None, ""),
        ("Repeat", "accent", None, ""), ("Operator", "dim", None, ""),
        ("PreProc", "cyan", None, ""), ("Include", "magenta", None, ""),
        ("Type", "yellow", None, ""), ("Special", "accent2", None, ""),
        ("Error", "urgent", None, "bold"), ("Todo", "yellow", "bg_alt", "bold"),
        ("Underlined", "accent2", None, "underline"),
        ("LineNr", "sel", None, ""), ("CursorLineNr", "accent", None, "bold"),
        ("CursorLine", None, "line", ""), ("CursorColumn", None, "line", ""),
        ("Visual", None, "sel", ""), ("Search", "bg", "yellow", ""),
        ("IncSearch", "bg", "accent", ""), ("MatchParen", "accent", "sel", "bold"),
        ("Pmenu", "fg", "bg_alt", ""), ("PmenuSel", "bg", "accent", "bold"),
        ("PmenuSbar", None, "sel", ""), ("PmenuThumb", None, "accent", ""),
        ("StatusLine", "fg", "bg_alt", ""), ("StatusLineNC", "dim", "bg_alt", ""),
        ("TabLine", "dim", "bg_alt", ""), ("TabLineSel", "accent", "bg", "bold"),
        ("VertSplit", "sel", None, ""), ("WinSeparator", "sel", None, ""),
        ("SignColumn", None, "bg", ""), ("ColorColumn", None, "bg_alt", ""),
        ("Folded", "dim", "bg_alt", ""), ("NonText", "sel", None, ""),
        ("Whitespace", "sel", None, ""), ("Directory", "blue", None, ""),
        ("Title", "accent", None, "bold"), ("ErrorMsg", "urgent", None, ""),
        ("WarningMsg", "yellow", None, ""), ("Question", "green", None, ""),
        ("MoreMsg", "green", None, ""), ("DiffAdd", "green", "bg_alt", ""),
        ("DiffChange", "yellow", "bg_alt", ""), ("DiffDelete", "urgent", "bg_alt", ""),
        ("DiffText", "accent", "bg_alt", "bold"),
        ("DiagnosticError", "urgent", None, ""), ("DiagnosticWarn", "yellow", None, ""),
        ("DiagnosticInfo", "blue", None, ""), ("DiagnosticHint", "cyan", None, ""),
    ]
    # Treesitter capture groups -> link to the above
    ts_links = {
        "@comment": "Comment", "@string": "String", "@string.escape": "Special",
        "@character": "Character", "@number": "Number", "@boolean": "Boolean",
        "@float": "Float", "@function": "Function", "@function.call": "Function",
        "@function.builtin": "Special", "@method": "Function", "@constructor": "Type",
        "@keyword": "Keyword", "@keyword.function": "Keyword", "@keyword.return": "Keyword",
        "@conditional": "Conditional", "@repeat": "Repeat", "@operator": "Operator",
        "@type": "Type", "@type.builtin": "Type", "@variable": "Identifier",
        "@variable.builtin": "Special", "@parameter": "Identifier", "@field": "Identifier",
        "@property": "Identifier", "@constant": "Constant", "@constant.builtin": "Constant",
        "@namespace": "Type", "@include": "Include", "@punctuation.delimiter": "Operator",
        "@punctuation.bracket": "Operator", "@tag": "Statement", "@tag.attribute": "Type",
        "@text.title": "Title", "@text.uri": "Underlined", "@label": "Special",
    }
    lines = [
        "-- AUTO-GENERATED by `theme`. Do not edit; edit hypr/themes/<name>.json.",
        "vim.o.termguicolors = true",
        f'vim.o.background = "{"dark" if dark else "light"}"',
        'vim.cmd("highlight clear")',
        'if vim.fn.exists("syntax_on") then vim.cmd("syntax reset") end',
        'vim.g.colors_name = "generated_theme"',
        "local set = vim.api.nvim_set_hl",
    ]
    for grp, fg, bg, extra in groups:
        parts = []
        if fg: parts.append(f'fg="{c[fg]}"')
        if bg: parts.append(f'bg="{c[bg]}"')
        for st in [e for e in extra.split(",") if e]:
            parts.append(f"{st}=true")
        lines.append(f'set(0, "{grp}", {{{", ".join(parts)}}})')
    for cap, link in ts_links.items():
        lines.append(f'set(0, "{cap}", {{link="{link}"}})')
    write(os.path.join(CFG, "nvim", "lua", "generated_theme.lua"), "\n".join(lines) + "\n")


def gen_wofi(r, s):
    """wofi launcher — colors.css (regenerated) @imported by style.css (created
    once). Non-invasive: style.css only gains one @import line."""
    rad = int(s.get("corner_radius", 10))
    hover = r.get("hover", blend(r["bg_alt"], r["accent"], 0.15))
    selected = r.get("selected", r["accent"])
    disabled = r.get("disabled", r["text_dim"])
    on_accent = r.get("on_accent", r["bg"])
    colors = (
        "/* AUTO-GENERATED by `theme` */\n"
        f"@define-color bg {r['bg']};\n@define-color bg_alt {r['bg_alt']};\n"
        f"@define-color fg {r['text']};\n@define-color fg_dim {r['text_dim']};\n"
        f"@define-color accent {r['accent']};\n@define-color urgent {r['urgent']};\n"
        f"@define-color hover {hover};\n@define-color selected {selected};\n"
        f"@define-color disabled {disabled};\n@define-color on_accent {on_accent};\n")
    write(os.path.join(CFG, "wofi", "colors.css"), colors)
    default_style = f'''/* base wofi style — colors come from colors.css */
#window {{ background-color: @bg; border: 2px solid @accent; border-radius: {rad}px; }}
#outer-box {{ background-color: transparent; padding: 4px; }}
#scroll {{ background-color: transparent; }}
#input {{ margin: 8px; padding: 6px; border-radius: {rad}px;
         background-color: @bg_alt; color: @fg; border: 1px solid @accent; }}
#inner-box {{ margin: 4px; }}
#entry {{ padding: 6px; border-radius: {rad}px; background-color: @bg; }}
#entry:selected {{ background-color: @accent; }}
#text {{ color: @fg; }}
#entry:selected #text {{ color: @bg; }}
'''
    style_path = os.path.join(CFG, "wofi", "style.css")
    colors_path = os.path.join(CFG, "wofi", "colors.css")
    import_line = f'@import url("file://{colors_path}");'
    legacy_import = '@import "colors.css";'
    if os.path.exists(style_path) and legacy_import in open(style_path).read():
        write(style_path, open(style_path).read().replace(legacy_import, import_line))
    else:
        ensure_import(style_path, import_line, default_style)
    style = open(style_path).read()
    geometry = (
        "\n/* AUTO-GENERATED by `theme`: Wofi geometry */\n"
        f"#window, #outer-box, #scroll, #inner-box, #input, #entry {{ border-radius: {rad}px; }}\n")
    style = re.sub(
        r'\n?/\* AUTO-GENERATED by `theme`: Wofi geometry \*/\n'
        r'#window, (?:#outer-box, #scroll, #inner-box, )?#input, #entry \{ border-radius: \d+px; \}\n?',
        "\n", style).rstrip() + geometry
    write(style_path, style)


