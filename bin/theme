#!/usr/bin/env python3
"""theme — one command to re-skin the whole desktop.

    theme                 # list themes (marks the active one)
    theme <name>          # switch: regenerate hypr/waybar/kitty/starship + reload
    theme --list          # bare list, one per line

Single source of truth: ~/.config/hypr/themes/<name>.json
Everything under */generated/ is written by this script — never edit it by hand.
"""
import json, os, sys, glob, subprocess, signal, shutil, time

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CFG, "hypr", "themes")
ACTIVE_FILE = os.path.join(CFG, "hypr", "generated", ".active")
TARGETS_FILE = os.path.join(CFG, "theme-engine", "targets.conf")

# Generators that run by default when no targets.conf exists (back-compat).
CORE_TARGETS = ["hypr", "waybar", "kitty", "starship", "nvim", "wallpaper"]


def load_targets():
    """Return {target: value} of enabled generators. `value` is True for a bare
    line, or a string for `target=value` (e.g. an Obsidian vault path)."""
    if not os.path.exists(TARGETS_FILE):
        return {t: True for t in CORE_TARGETS}
    out = {}
    for raw in open(TARGETS_FILE):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            out[k.strip()] = os.path.expanduser(v.strip())
        else:
            out[line] = True
    return out


def backup_once(path):
    """Copy path to path.bak-<ts> the first time we ever touch it."""
    if os.path.exists(path) and not glob.glob(path + ".bak-*"):
        shutil.copy2(path, path + ".bak-" + str(int(time.time())))


def ensure_import(path, import_line, default=""):
    """Guarantee import_line is the first line of the file at path (creating it
    with `default` if absent). Backs up an existing file once. Returns nothing."""
    exists = os.path.exists(path)
    content = open(path).read() if exists else ""
    if import_line in content:
        return
    if exists:
        backup_once(path)
    else:
        content = default
    write(path, import_line + "\n" + content)


def themes():
    return sorted(os.path.splitext(os.path.basename(p))[0]
                  for p in glob.glob(os.path.join(THEME_DIR, "*.json")))


def active():
    try:
        return open(ACTIVE_FILE).read().strip()
    except OSError:
        return None


def h(c):            # "#1e1e2e" -> "1e1e2e"
    return c.lstrip("#")


def a(op):           # 0.4 -> "66"  (alpha hex byte)
    return format(max(0, min(255, int(round(float(op) * 255)))), "02x")


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def gen_hypr(r, s):
    blur_on = str(s.get("blur_on", "true")).lower() == "true"
    shadow_on = str(s.get("shadow_on", "true")).lower() == "true"
    gaps = int(s.get("gaps", 8))
    lines = [
        "# AUTO-GENERATED by `theme`. Edit hypr/themes/<name>.json instead.",
        f"$bg = rgb({h(r['bg'])})",
        f"$bg_alt = rgb({h(r['bg_alt'])})",
        f"$fg = rgb({h(r['text'])})",
        f"$fg_dim = rgb({h(r['text_dim'])})",
        f"$accent = rgb({h(r['accent'])})",
        f"$accent2 = rgb({h(r['accent2'])})",
        f"$urgent = rgb({h(r['urgent'])})",
        "",
        "general {",
        f"    border_size = {int(s.get('border_width', 2))}",
        f"    gaps_in = {max(0, gaps // 2)}",
        f"    gaps_out = {gaps}",
        f"    col.active_border = rgba({h(r['focus'])}ff) rgba({h(r['accent2'])}ff) 45deg",
        f"    col.inactive_border = rgba({h(r['border_normal'])}aa)",
        "}",
        "",
        "decoration {",
        f"    rounding = {int(s.get('corner_radius', 10))}",
        f"    active_opacity = {float(s.get('opacity', 1.0))}",
        f"    inactive_opacity = {float(s.get('opacity_inactive', 1.0))}",
        f"    dim_inactive = {'true' if float(s.get('inactive_dim', 0)) > 0 else 'false'}",
        f"    dim_strength = {float(s.get('inactive_dim', 0))}",
        "    blur {",
        f"        enabled = {'true' if blur_on else 'false'}",
        f"        size = {int(s.get('blur_strength', 8))}",
        "        passes = 3",
        "        new_optimizations = true",
        "        xray = false",
        "    }",
        "    shadow {",
        f"        enabled = {'true' if shadow_on else 'false'}",
        f"        range = {int(s.get('shadow_radius', 20))}",
        "        render_power = 3",
        f"        color = rgba({h(s.get('shadow_color', '#000000'))}{a(s.get('shadow_opacity', 0.4))})",
        "    }",
        "}",
    ]
    write(os.path.join(CFG, "hypr", "generated", "theme.conf"), "\n".join(lines) + "\n")


def gen_waybar(r):
    keys = ["bg", "bg_alt", "text", "text_dim", "accent", "accent2", "urgent", "focus"]
    css = "/* AUTO-GENERATED by `theme` */\n" + "".join(
        f"@define-color {k} {r[k]};\n" for k in keys)
    write(os.path.join(CFG, "waybar", "generated", "theme.css"), css)


def gen_kitty(r, s):
    m = [("background", r["bg"]), ("foreground", r["text"]),
         ("cursor", r.get("cursor", r["accent"])),
         ("selection_background", r.get("sel_bg", r["accent"])),
         ("selection_foreground", r.get("sel_fg", r["bg"]))]
    ansi = ["ansi_black", "ansi_red", "ansi_green", "ansi_yellow", "ansi_blue",
            "ansi_magenta", "ansi_cyan", "ansi_white", "ansi_br_black", "ansi_br_red",
            "ansi_br_green", "ansi_br_yellow", "ansi_br_blue", "ansi_br_magenta",
            "ansi_br_cyan", "ansi_br_white"]
    out = "# AUTO-GENERATED by `theme`\n"
    out += "".join(f"{k:22}{v}\n" for k, v in m)
    out += f"font_size {int(s.get('term_fontsize', 12))}\n"
    for i, key in enumerate(ansi):
        out += f"color{i:<2} {r.get(key, r['text'])}\n"
    write(os.path.join(CFG, "kitty", "generated", "theme.conf"), out)


def gen_wallpaper(name):
    """Point hyprpaper at ~/.config/<name>/wallpaper.png if it exists,
    else fall back to ~/.config/hypr/wallpaper.png. Returns the path used."""
    # prefer a wallgen "blurry blob" wallpaper, then ~/.config/<name>/, then default
    generated = os.path.join(CFG, "hypr", "wallpapers", name + ".png")
    cand = os.path.join(CFG, name, "wallpaper.png")
    default = os.path.join(CFG, "hypr", "wallpaper.png")
    wp = next((p for p in (generated, cand, default) if os.path.exists(p)), default)
    write(os.path.join(CFG, "hypr", "hyprpaper.conf"),
          f"preload = {wp}\nwallpaper = , {wp}\nsplash = false\n")
    return wp


def gen_starship(r):
    toml = f'''# AUTO-GENERATED by `theme`
"$schema" = 'https://starship.rs/config-schema.json'
format = "$directory$git_branch$git_status$character"
add_newline = false
palette = "theme"

[palettes.theme]
bg = "{r['bg_alt']}"
fg = "{r['text']}"
accent = "{r['accent']}"
accent2 = "{r['accent2']}"
urgent = "{r['urgent']}"

[directory]
style = "bold accent"
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = " "
style = "bold accent2"

[git_status]
style = "urgent"

[character]
success_symbol = "[❯](bold accent)"
error_symbol = "[❯](bold urgent)"
vimcmd_symbol = "[❮](bold accent2)"
'''
    path = os.path.join(CFG, "starship.toml")
    if os.path.exists(path) and "AUTO-GENERATED by `theme`" not in open(path).read():
        backup_once(path)   # never silently clobber a hand-made prompt
    write(path, toml)


def gen_nvim(r, dark):
    """Generate a Neovim colorscheme from the palette (works for every theme,
    including custom ones). Written to ~/.config/nvim/lua/generated_theme.lua
    and self-applied when required."""
    def g(k, d="text"):
        return r.get(k, r[d])
    c = {
        "bg": r["bg"], "bg_alt": r["bg_alt"], "fg": r["text"], "dim": r["text_dim"],
        "sel": r.get("border_normal", r["bg_alt"]), "line": r.get("ansi_br_black", r["bg_alt"]),
        "accent": r["accent"], "accent2": r["accent2"], "urgent": r["urgent"],
        "red": g("ansi_red", "urgent"), "green": g("ansi_green"), "yellow": g("ansi_yellow"),
        "blue": g("ansi_blue"), "magenta": g("ansi_magenta"), "cyan": g("ansi_cyan"),
    }
    # (group, fg, bg, extra) — extra is a comma-separated style string or ""
    groups = [
        ("Normal", "fg", "bg", ""), ("NormalFloat", "fg", "bg_alt", ""),
        ("Comment", "dim", None, "italic"), ("Constant", "cyan", None, ""),
        ("String", "green", None, ""), ("Character", "green", None, ""),
        ("Number", "accent2", None, ""), ("Boolean", "accent2", None, ""),
        ("Float", "accent2", None, ""), ("Identifier", "fg", None, ""),
        ("Function", "blue", None, ""), ("Statement", "accent", None, ""),
        ("Keyword", "accent", None, "italic"), ("Conditional", "accent", None, ""),
        ("Repeat", "accent", None, ""), ("Operator", "dim", None, ""),
        ("PreProc", "cyan", None, ""), ("Include", "magenta", None, ""),
        ("Type", "yellow", None, ""), ("Special", "accent2", None, ""),
        ("Error", "urgent", None, "bold"), ("Todo", "yellow", "bg_alt", "bold"),
        ("Underlined", "accent2", None, "underline"),
        ("LineNr", "sel", None, ""), ("CursorLineNr", "accent", None, "bold"),
        ("CursorLine", None, "line", ""), ("CursorColumn", None, "line", ""),
        ("Visual", None, "sel", ""), ("Search", "bg", "yellow", ""),
        ("IncSearch", "bg", "accent", ""), ("MatchParen", "accent", "sel", "bold"),
        ("Pmenu", "fg", "bg_alt", ""), ("PmenuSel", "bg", "accent", "bold"),
        ("PmenuSbar", None, "sel", ""), ("PmenuThumb", None, "accent", ""),
        ("StatusLine", "fg", "bg_alt", ""), ("StatusLineNC", "dim", "bg_alt", ""),
        ("TabLine", "dim", "bg_alt", ""), ("TabLineSel", "accent", "bg", "bold"),
        ("VertSplit", "sel", None, ""), ("WinSeparator", "sel", None, ""),
        ("SignColumn", None, "bg", ""), ("ColorColumn", None, "bg_alt", ""),
        ("Folded", "dim", "bg_alt", ""), ("NonText", "sel", None, ""),
        ("Whitespace", "sel", None, ""), ("Directory", "blue", None, ""),
        ("Title", "accent", None, "bold"), ("ErrorMsg", "urgent", None, ""),
        ("WarningMsg", "yellow", None, ""), ("Question", "green", None, ""),
        ("MoreMsg", "green", None, ""), ("DiffAdd", "green", "bg_alt", ""),
        ("DiffChange", "yellow", "bg_alt", ""), ("DiffDelete", "urgent", "bg_alt", ""),
        ("DiffText", "accent", "bg_alt", "bold"),
        ("DiagnosticError", "urgent", None, ""), ("DiagnosticWarn", "yellow", None, ""),
        ("DiagnosticInfo", "blue", None, ""), ("DiagnosticHint", "cyan", None, ""),
    ]
    # Treesitter capture groups -> link to the above
    ts_links = {
        "@comment": "Comment", "@string": "String", "@string.escape": "Special",
        "@character": "Character", "@number": "Number", "@boolean": "Boolean",
        "@float": "Float", "@function": "Function", "@function.call": "Function",
        "@function.builtin": "Special", "@method": "Function", "@constructor": "Type",
        "@keyword": "Keyword", "@keyword.function": "Keyword", "@keyword.return": "Keyword",
        "@conditional": "Conditional", "@repeat": "Repeat", "@operator": "Operator",
        "@type": "Type", "@type.builtin": "Type", "@variable": "Identifier",
        "@variable.builtin": "Special", "@parameter": "Identifier", "@field": "Identifier",
        "@property": "Identifier", "@constant": "Constant", "@constant.builtin": "Constant",
        "@namespace": "Type", "@include": "Include", "@punctuation.delimiter": "Operator",
        "@punctuation.bracket": "Operator", "@tag": "Statement", "@tag.attribute": "Type",
        "@text.title": "Title", "@text.uri": "Underlined", "@label": "Special",
    }
    lines = [
        "-- AUTO-GENERATED by `theme`. Do not edit; edit hypr/themes/<name>.json.",
        "vim.o.termguicolors = true",
        f'vim.o.background = "{"dark" if dark else "light"}"',
        'vim.cmd("highlight clear")',
        'if vim.fn.exists("syntax_on") then vim.cmd("syntax reset") end',
        'vim.g.colors_name = "generated_theme"',
        "local set = vim.api.nvim_set_hl",
    ]
    for grp, fg, bg, extra in groups:
        parts = []
        if fg: parts.append(f'fg="{c[fg]}"')
        if bg: parts.append(f'bg="{c[bg]}"')
        for st in [e for e in extra.split(",") if e]:
            parts.append(f"{st}=true")
        lines.append(f'set(0, "{grp}", {{{", ".join(parts)}}})')
    for cap, link in ts_links.items():
        lines.append(f'set(0, "{cap}", {{link="{link}"}})')
    write(os.path.join(CFG, "nvim", "lua", "generated_theme.lua"), "\n".join(lines) + "\n")


def gen_wofi(r, s):
    """wofi launcher — colors.css (regenerated) @imported by style.css (created
    once). Non-invasive: style.css only gains one @import line."""
    rad = int(s.get("corner_radius", 10))
    colors = (
        "/* AUTO-GENERATED by `theme` */\n"
        f"@define-color bg {r['bg']};\n@define-color bg_alt {r['bg_alt']};\n"
        f"@define-color fg {r['text']};\n@define-color fg_dim {r['text_dim']};\n"
        f"@define-color accent {r['accent']};\n@define-color urgent {r['urgent']};\n")
    write(os.path.join(CFG, "wofi", "colors.css"), colors)
    default_style = f'''/* base wofi style — colors come from colors.css */
window {{ background-color: @bg; border: 2px solid @accent; border-radius: {rad}px; }}
#input {{ margin: 8px; padding: 6px; border-radius: {rad}px;
         background-color: @bg_alt; color: @fg; border: 1px solid @accent; }}
#inner-box {{ margin: 4px; }}
#entry {{ padding: 6px; border-radius: {rad}px; }}
#entry:selected {{ background-color: @accent; }}
#text {{ color: @fg; }}
#entry:selected #text {{ color: @bg; }}
'''
    ensure_import(os.path.join(CFG, "wofi", "style.css"),
                  '@import "colors.css";', default_style)


def gen_rofi(r, s):
    """rofi theme (used by the launcher AND rofi-rbw / any rofi menu)."""
    rad = int(s.get("corner_radius", 10))
    rasi = f'''/* AUTO-GENERATED by `theme` */
* {{
    bg:      {r['bg']};
    bg-alt:  {r['bg_alt']};
    fg:      {r['text']};
    fg-dim:  {r['text_dim']};
    accent:  {r['accent']};
    urgent:  {r['urgent']};
    background-color: transparent;
    text-color: @fg;
}}
window {{ background-color: @bg; border: 2px; border-color: @accent;
         border-radius: {rad}px; width: 640px; padding: 12px; }}
inputbar {{ children: [prompt, entry]; padding: 8px; spacing: 8px;
            background-color: @bg-alt; border-radius: {rad}px; }}
prompt {{ text-color: @accent; }}
entry {{ placeholder: "search…"; placeholder-color: @fg-dim; }}
listview {{ lines: 8; padding: 8px 0; }}
element {{ padding: 8px; border-radius: {rad}px; }}
element selected {{ background-color: @accent; text-color: @bg; }}
element-text {{ background-color: transparent; text-color: inherit; }}
'''
    write(os.path.join(CFG, "rofi", "theme-engine.rasi"), rasi)
    ensure_import(os.path.join(CFG, "rofi", "config.rasi"),
                  '@theme "~/.config/rofi/theme-engine.rasi"',
                  'configuration { modi: "drun,run"; }\n')


def gen_dunst(r, s):
    """dunst notifications. No include mechanism, so we write a full dunstrc
    (backing up any existing one) from a themed template."""
    rad = int(s.get("corner_radius", 10))
    bw = int(s.get("border_width", 2))
    path = os.path.join(CFG, "dunst", "dunstrc")
    backup_once(path)
    cfg = f'''# AUTO-GENERATED by `theme`
[global]
    font = JetBrainsMono Nerd Font 10
    frame_width = {bw}
    frame_color = "{r['accent']}"
    corner_radius = {rad}
    separator_color = frame
    offset = 12x12
    padding = 12
    horizontal_padding = 12
    width = 340
    origin = top-right

[urgency_low]
    background = "{r['bg_alt']}"
    foreground = "{r['text_dim']}"
    frame_color = "{r['bg_alt']}"

[urgency_normal]
    background = "{r['bg']}"
    foreground = "{r['text']}"
    frame_color = "{r['accent']}"

[urgency_critical]
    background = "{r['bg']}"
    foreground = "{r['text']}"
    frame_color = "{r['urgent']}"
'''
    write(path, cfg)


def gen_hyprlock(r, s):
    """Lock screen colors (hyprlock.conf is ours; safe to regenerate)."""
    rad = int(s.get("corner_radius", 10))
    cfg = f'''# AUTO-GENERATED by `theme`
background {{ color = rgba({h(r['bg'])}ff) }}
input-field {{
    size = 280, 50
    outline_thickness = 2
    outer_color = rgba({h(r['accent'])}ff)
    inner_color = rgba({h(r['bg_alt'])}ff)
    font_color = rgba({h(r['text'])}ff)
    check_color = rgba({h(r['accent2'])}ff)
    fail_color = rgba({h(r['urgent'])}ff)
    rounding = {rad}
    placeholder_text = <i>password…</i>
    position = 0, -20
    halign = center
    valign = center
}}
label {{
    text = $TIME
    color = rgba({h(r['accent'])}ff)
    font_size = 64
    position = 0, 120
    halign = center
    valign = center
}}
'''
    write(os.path.join(CFG, "hypr", "hyprlock.conf"), cfg)


def gen_obsidian(r, dark, vault):
    """CSS snippet in the vault mapping palette -> Obsidian CSS vars, and enable
    it in appearance.json. Obsidian hot-reloads snippet edits."""
    if not isinstance(vault, str) or not os.path.isdir(os.path.join(vault, ".obsidian")):
        return
    snip_dir = os.path.join(vault, ".obsidian", "snippets")
    css = f'''/* AUTO-GENERATED by `theme` */
body {{
  --background-primary: {r['bg']};
  --background-primary-alt: {r['bg_alt']};
  --background-secondary: {r['bg_alt']};
  --background-secondary-alt: {r['bg_alt']};
  --text-normal: {r['text']};
  --text-muted: {r['text_dim']};
  --text-accent: {r['accent']};
  --text-accent-hover: {r['accent2']};
  --interactive-accent: {r['accent']};
  --interactive-accent-hover: {r['accent2']};
  --text-selection: {r['accent']}40;
  --text-error: {r['urgent']};
}}
'''
    write(os.path.join(snip_dir, "theme-engine.css"), css)
    ap = os.path.join(vault, ".obsidian", "appearance.json")
    try:
        data = json.load(open(ap)) if os.path.exists(ap) else {}
    except (OSError, ValueError):
        data = {}
    snips = data.get("enabledCssSnippets", [])
    if "theme-engine" not in snips:
        snips.append("theme-engine")
    data["enabledCssSnippets"] = snips
    write(ap, json.dumps(data, indent=2))


def gen_firefox(r, dark):
    """userChrome.css tint for the Firefox toolbar (chrome only; needs restart).
    Enables legacy stylesheets via user.js. Requires an existing profile."""
    base = os.path.join(HOME, ".mozilla", "firefox")
    profs = glob.glob(os.path.join(base, "*.default*"))
    if not profs:
        return
    prof = profs[0]
    css = f'''/* AUTO-GENERATED by `theme` (chrome only; restart Firefox) */
:root {{
  --toolbar-bgcolor: {r['bg']} !important;
  --toolbar-color: {r['text']} !important;
}}
#navigator-toolbox {{ background-color: {r['bg_alt']} !important; }}
#nav-bar, #TabsToolbar {{ background-color: {r['bg']} !important; }}
.tab-background[selected] {{ background-color: {r['bg_alt']} !important; }}
#urlbar {{ background-color: {r['bg_alt']} !important; color: {r['text']} !important; }}
.tabbrowser-tab {{ color: {r['text_dim']} !important; }}
.tabbrowser-tab[selected] {{ color: {r['accent']} !important; }}
'''
    write(os.path.join(prof, "chrome", "userChrome.css"), css)
    ensure_import(os.path.join(prof, "user.js"),
                  'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);')


def _kde_rgb(c):     # "#1e1e2e" -> "30,30,46"
    c = c.lstrip("#")
    return f"{int(c[0:2],16)},{int(c[2:4],16)},{int(c[4:6],16)}"


def gen_kde(r, s, dark):
    """Plasma color scheme -> ~/.local/share/color-schemes + apply it."""
    K = _kde_rgb
    scheme = f'''[General]
ColorScheme=ThemeEngine
Name=ThemeEngine

[Colors:Window]
BackgroundNormal={K(r['bg'])}
ForegroundNormal={K(r['text'])}

[Colors:View]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}
DecorationFocus={K(r['accent'])}

[Colors:Button]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}

[Colors:Selection]
BackgroundNormal={K(r['accent'])}
ForegroundNormal={K(r['bg'])}

[Colors:Tooltip]
BackgroundNormal={K(r['bg_alt'])}
ForegroundNormal={K(r['text'])}

[Colors:Complementary]
BackgroundNormal={K(r['bg'])}
ForegroundNormal={K(r['text'])}

[WM]
activeBackground={K(r['bg_alt'])}
activeForeground={K(r['text'])}
inactiveBackground={K(r['bg'])}
inactiveForeground={K(r['text_dim'])}
'''
    write(os.path.join(HOME, ".local", "share", "color-schemes", "ThemeEngine.colors"), scheme)


def gen_oomox(r, s, dark):
    """Write an oomox preset from the palette. Building/applying is done in
    reload() via oomox-cli (it's slow, so guarded there)."""
    preset = f'''# AUTO-GENERATED by `theme`
THEME_STYLE=materia
BG={h(r['bg'])}
FG={h(r['text'])}
MENU_BG={h(r['bg_alt'])}
MENU_FG={h(r['text'])}
SEL_BG={h(r['accent'])}
SEL_FG={h(r['bg'])}
TXT_BG={h(r['bg_alt'])}
TXT_FG={h(r['text'])}
BTN_BG={h(r['bg_alt'])}
BTN_FG={h(r['text'])}
HDR_BTN_BG={h(r['bg'])}
HDR_BTN_FG={h(r['text'])}
GTK3_GENERATE_DARK={'True' if dark else 'False'}
ROUNDNESS={int(s.get('corner_radius', 8))}
MATERIA_STYLE_COMPACT=True
ICONS_STYLE=archdroid
ICONS_ARCHDROID={h(r['accent'])}
'''
    write(os.path.join(CFG, "oomox", "colors", "theme-engine"), preset)


def gen_gtk(r, dark):
    """Non-invasive GTK recolor via @define-color overrides (fallback when oomox
    isn't used). Injected into gtk-3.0/gtk.css and gtk-4.0/gtk.css."""
    block = (
        "/* THEME-ENGINE-START */\n"
        f"@define-color theme_bg_color {r['bg']};\n"
        f"@define-color theme_base_color {r['bg_alt']};\n"
        f"@define-color theme_fg_color {r['text']};\n"
        f"@define-color theme_text_color {r['text']};\n"
        f"@define-color theme_selected_bg_color {r['accent']};\n"
        f"@define-color theme_selected_fg_color {r['bg']};\n"
        f"@define-color accent_color {r['accent']};\n"
        f"@define-color accent_bg_color {r['accent']};\n"
        "/* THEME-ENGINE-END */\n")
    for ver in ("gtk-3.0", "gtk-4.0"):
        path = os.path.join(CFG, ver, "gtk.css")
        old = open(path).read() if os.path.exists(path) else ""
        import re
        old = re.sub(r"/\* THEME-ENGINE-START \*/.*?/\* THEME-ENGINE-END \*/\n?",
                     "", old, flags=re.S)
        if os.path.exists(path):
            backup_once(path)
        write(path, block + old)


def gen_xfce(r):
    """xfce4-terminal color scheme (applied by xfce4-terminal on next open)."""
    pal = ";".join(r.get(k, r["text"]) for k in
                   ["ansi_black", "ansi_red", "ansi_green", "ansi_yellow",
                    "ansi_blue", "ansi_magenta", "ansi_cyan", "ansi_white",
                    "ansi_br_black", "ansi_br_red", "ansi_br_green", "ansi_br_yellow",
                    "ansi_br_blue", "ansi_br_magenta", "ansi_br_cyan", "ansi_br_white"])
    cfg = (f"[Configuration]\nColorForeground={r['text']}\nColorBackground={r['bg']}\n"
           f"ColorCursor={r['accent']}\nColorPalette={pal}\n")
    path = os.path.join(CFG, "xfce4", "terminal", "terminalrc")
    backup_once(path)   # preserve any existing xfce terminal config
    write(path, cfg)


def reload():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    def run(*c):
        try:
            subprocess.run(c, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            pass  # tool not installed / not running — reload is best-effort
    run("hyprctl", "reload")
    run("pkill", "-USR2", "-x", "waybar")  # waybar reloads config + css in place
    run("pkill", "-USR1", "-x", "kitty")   # kitty re-reads its config
    # hyprpaper has no live-reload IPC for the config file — restart it
    run("pkill", "-x", "hyprpaper")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.Popen(["hyprpaper"], env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run("dunstctl", "reload")               # dunst re-reads its config
    # live-reload any running nvim instances (best effort, via their sockets)
    theme_lua = os.path.join(CFG, "nvim", "lua", "generated_theme.lua")
    rt = env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        socks = [os.path.join(rt, f) for f in os.listdir(rt) if f.startswith("nvim.")]
    except OSError:
        socks = []
    for sock in socks:
        run("nvim", "--server", sock, "--remote-send",
            f"<C-\\><C-N>:luafile {theme_lua}<CR>")
    # --- host desktop-environment apply (only if those targets are enabled) ---
    tg = load_targets()
    if "kde" in tg:
        run("plasma-apply-colorscheme", "ThemeEngine")
    if "oomox" in tg and shutil.which("oomox-cli"):
        preset = os.path.join(CFG, "oomox", "colors", "theme-engine")
        run("oomox-cli", preset)            # builds+installs oomox-theme-engine
        name = "oomox-theme-engine"
        run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", name)
        run("gsettings", "set", "org.cinnamon.desktop.interface", "gtk-theme", name)
        run("gsettings", "set", "org.cinnamon.theme", "name", name)
        run("xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", name)


def apply(name):
    path = os.path.join(THEME_DIR, name + ".json")
    if not os.path.exists(path):
        sys.exit(f"theme: unknown theme '{name}'. Try: theme --list")
    t = json.load(open(path))
    r, s, dark = t["roles"], t.get("style", {}), t.get("dark", True)
    tg = load_targets()
    if "hypr" in tg:      gen_hypr(r, s)
    if "waybar" in tg:    gen_waybar(r)
    if "kitty" in tg:     gen_kitty(r, s)
    if "starship" in tg:  gen_starship(r)
    if "nvim" in tg:      gen_nvim(r, dark)
    if "wallpaper" in tg: gen_wallpaper(name)
    if "wofi" in tg:      gen_wofi(r, s)
    if "rofi" in tg:      gen_rofi(r, s)
    if "dunst" in tg:     gen_dunst(r, s)
    if "hyprlock" in tg:  gen_hyprlock(r, s)
    if "obsidian" in tg:  gen_obsidian(r, dark, tg["obsidian"])
    if "firefox" in tg:   gen_firefox(r, dark)
    if "kde" in tg:       gen_kde(r, s, dark)
    if "oomox" in tg:     gen_oomox(r, s, dark)
    if "gtk" in tg:       gen_gtk(r, dark)
    if "xfce" in tg:      gen_xfce(r)
    write(ACTIVE_FILE, name + "\n")
    reload()
    print(f"theme -> {name}  ({', '.join(k for k in tg)} regenerated)")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-l", "--list"):
        print("\n".join(themes())); return
    if not args:
        cur = active()
        for t in themes():
            print(f"  {'* ' if t == cur else '  '}{t}")
        return
    apply(args[0])


if __name__ == "__main__":
    main()
