def gen_homepage(r, s, name, texture_name=None):
    eww_dir = os.path.join(CFG, "eww", "homepage")
    scss = theme_homepage.render_scss(r, s, texture_name)
    write(os.path.join(eww_dir, "eww.scss"), scss)
    hp = theme_homepage.profile()
    yuck = theme_homepage.render_yuck(hp, theme_name=name, effects_preset=texture_name)
    write(os.path.join(eww_dir, "eww.yuck"), yuck)
    scripts_dir = os.path.join(eww_dir, "scripts")
    for fname, content in theme_homepage.render_scripts().items():
        spath = os.path.join(scripts_dir, fname)
        write(spath, content)
        os.chmod(spath, 0o755)


def gen_obsidian(r, dark, vault):
    """CSS snippet in the vault mapping palette -> Obsidian CSS vars, and enable
    it in appearance.json. Obsidian hot-reloads snippet edits."""
    if not isinstance(vault, str) or not os.path.isdir(os.path.join(vault, ".obsidian")):
        return
    snip_dir = os.path.join(vault, ".obsidian", "snippets")
    css = f'''/* AUTO-GENERATED by `theme` */
body {{
  --background-primary: {r['bg']};
  --background-primary-alt: {r['bg_alt']};
  --background-secondary: {r['bg_alt']};
  --background-secondary-alt: {r['bg_alt']};
  --text-normal: {r['text']};
  --text-muted: {r['text_dim']};
  --text-accent: {r['accent']};
  --text-accent-hover: {r['accent2']};
  --interactive-accent: {r['accent']};
  --interactive-accent-hover: {r['accent2']};
  --text-selection: {r['accent']}40;
  --text-error: {r['urgent']};
}}
'''
    write(os.path.join(snip_dir, "theme-engine.css"), css)
    ap = os.path.join(vault, ".obsidian", "appearance.json")
    try:
        data = json.load(open(ap)) if os.path.exists(ap) else {}
    except (OSError, ValueError):
        data = {}
    snips = data.get("enabledCssSnippets", [])
    if "theme-engine" not in snips:
        snips.append("theme-engine")
    data["enabledCssSnippets"] = snips
    write(ap, json.dumps(data, indent=2))


def gen_firefox(r, dark):
    """Theme the toolbar (userChrome.css) of every Firefox-family browser found,
    and emit pywal colors for pywalfox (chrome + pages, live via `pywalfox
    update` in reload()). Chrome-only via userChrome needs a restart."""
    css = f'''/* AUTO-GENERATED by `theme` (chrome only; restart the browser) */
:root {{
  --toolbar-bgcolor: {r['bg']} !important;
  --toolbar-color: {r['text']} !important;
}}
#navigator-toolbox {{ background-color: {r['bg_alt']} !important; }}
#nav-bar, #TabsToolbar {{ background-color: {r['bg']} !important; }}
.tab-background[selected] {{ background-color: {r['bg_alt']} !important; }}
#urlbar {{ background-color: {r['bg_alt']} !important; color: {r['text']} !important; }}
.tabbrowser-tab {{ color: {r['text_dim']} !important; }}
.tabbrowser-tab[selected] {{ color: {r['accent']} !important; }}
'''
    # every Firefox-family profile root -> theme whichever exist
    roots = [".mozilla/firefox", ".librewolf", ".zen", ".mullvad-browser",
             ".floorp", ".waterfox", ".mozilla/icecat"]
    for root in roots:
        for prof in glob.glob(os.path.join(HOME, root, "*.default*")) + \
                    glob.glob(os.path.join(HOME, root, "*", "*.default*")):
            if not os.path.isdir(prof):
                continue
            write(os.path.join(prof, "chrome", "userChrome.css"), css)
            ensure_import(os.path.join(prof, "user.js"),
                'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);')
    # pywal palette for the Pywalfox add-on (chrome + web pages)
    ansi = ["ansi_black", "ansi_red", "ansi_green", "ansi_yellow", "ansi_blue",
            "ansi_magenta", "ansi_cyan", "ansi_white", "ansi_br_black", "ansi_br_red",
            "ansi_br_green", "ansi_br_yellow", "ansi_br_blue", "ansi_br_magenta",
            "ansi_br_cyan", "ansi_br_white"]
    walcolors = {
        "special": {"background": r["bg"], "foreground": r["text"],
                    "cursor": r.get("cursor", r["accent"])},
        "colors": {f"color{i}": r.get(k, r["text"]) for i, k in enumerate(ansi)},
    }
    write(os.path.join(HOME, ".cache", "wal", "colors.json"),
          json.dumps(walcolors, indent=2))


def gen_alacritty(r, s):
    """Alacritty colors via an imported TOML (keeps the user's alacritty.toml)."""
    def q(c):
        return f"'{c}'"
    toml = f'''# AUTO-GENERATED by `theme`
[colors.primary]
background = {q(r['bg'])}
foreground = {q(r['text'])}
[colors.cursor]
cursor = {q(r.get('cursor', r['accent']))}
text = {q(r['bg'])}
[colors.selection]
background = {q(r.get('sel_bg', r['accent']))}
text = {q(r['bg'])}
[colors.normal]
black = {q(r['ansi_black'])}
red = {q(r['ansi_red'])}
green = {q(r['ansi_green'])}
yellow = {q(r['ansi_yellow'])}
blue = {q(r['ansi_blue'])}
magenta = {q(r['ansi_magenta'])}
cyan = {q(r['ansi_cyan'])}
white = {q(r['ansi_white'])}
[colors.bright]
black = {q(r['ansi_br_black'])}
red = {q(r['ansi_br_red'])}
green = {q(r['ansi_br_green'])}
yellow = {q(r['ansi_br_yellow'])}
