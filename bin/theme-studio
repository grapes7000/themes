#!/usr/bin/env python3
"""Installed `theme` command: Theme Studio UI plus backward-compatible CLI."""
from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

import theme_runtime
import theme_ui
from theme_schema import validation_summary, validate_theme


def usage() -> str:
    return """theme — desktop theme studio

Interactive:
  theme                     Open Theme Studio
  theme studio              Open Theme Studio
  theme edit [name]         Open a theme in Theme Studio

Compatible commands:
  theme <name>              Apply a theme and Studio component overrides
  theme --list              List themes
  theme shape ...           Existing shape commands
  theme texture ...         Existing texture commands
  theme anim ...            Existing animation commands
  theme homepage ...        Existing homepage commands
  theme font ...            Existing font commands
  theme wallpaper ...       Semantic wallpaper template commands
  theme ui ...              Application UI-style profile commands

Wallpaper templates:
  theme wallpaper                   Show active template
  theme wallpaper --list            List templates
  theme wallpaper use <name>        Activate a template
  theme wallpaper none              Disable semantic recoloring
  theme wallpaper import IMAGE      Import and map a flat-color image

Studio utilities:
  theme validate [name]     Validate a theme
  theme recover             Open Theme Studio recovery flow
  theme legacy ...          Run the previous command directly
"""


def run_legacy(args: list[str]) -> int:
    command = theme_runtime.legacy_command()
    if not command:
        print("theme: legacy generator was not found. Re-run the themes installer.", file=sys.stderr)
        return 127
    return subprocess.call(command + args)


def _hex(color: str) -> str:
    return str(color).lstrip("#")


def _alpha(value: float) -> str:
    return f"{max(0, min(255, round(float(value) * 255))):02x}"


def _bool(value: object, default: bool = False) -> bool:
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    return str(value).lower() in {"1", "true", "yes", "on"}


def _sync_hypr_lua(name: str) -> None:
    """Write the Lua Hyprland mirror before the legacy command's normal reload.

    Arch-WM's active Hyprland config imports generated/theme.lua. The classic
    theme generator owns the canonical palette/style and writes theme.conf, so
    mirror those same resolved roles into theme.lua here. This is intentionally
    just a file write: the legacy apply that immediately follows performs the
    existing reload, avoiding the extra reload/test command that made switching
    noticeably slower.
    """
    if not theme_runtime.target_enabled("hypr"):
        return

    import theme_effects

    theme = theme_runtime.load_theme(name)
    roles = dict(theme.get("roles", {}))
    style = dict(theme.get("style", {}))
    required = ("bg", "accent", "text")
    missing = [key for key in required if key not in roles]
    if missing:
        raise ValueError("theme is missing roles: " + ", ".join(missing))

    roles.setdefault("bg_alt", roles["bg"])
    roles.setdefault("focus", roles["accent"])
    roles.setdefault("accent2", roles["accent"])
    roles.setdefault("border_normal", roles["bg_alt"])
    style = theme_effects.resolve(
        style,
        theme_effects.profile_shape(),
        theme_effects.profile_texture(),
    )

    gaps = int(style.get("gaps", 8))
    focus = f"rgba({_hex(roles['focus'])}ff)"
    accent2 = f"rgba({_hex(roles['accent2'])}ff)"
    inactive = f"rgba({_hex(roles['border_normal'])}aa)"
    shadow_color = _hex(style.get("shadow_color", roles.get("shadow", "#000000")))
    shadow_argb = f"0x{_alpha(style.get('shadow_opacity', 0.4))}{shadow_color}"

    lines = [
        "-- AUTO-GENERATED by `theme`; canonical Lua mirror of theme.conf.",
        f"-- Theme: {name}",
        "hl.config({",
        "    general = {",
        f"        border_size = {int(style.get('border_width', 2))},",
        f"        gaps_in = {max(0, gaps // 2)},",
        f"        gaps_out = {gaps},",
        "        col = {",
        "            active_border = {",
        f"                colors = {{ {json.dumps(focus)}, {json.dumps(accent2)} }},",
        "                angle = 45,",
        "            },",
        f"            inactive_border = {json.dumps(inactive)},",
        "        },",
        "    },",
        "    decoration = {",
        f"        rounding = {int(style.get('corner_radius', 10))},",
        f"        rounding_power = {float(style.get('rounding_power', 2.0))},",
        f"        active_opacity = {float(style.get('opacity', 1.0))},",
        f"        inactive_opacity = {float(style.get('opacity_inactive', 1.0))},",
        f"        dim_inactive = {str(float(style.get('inactive_dim', 0)) > 0).lower()},",
        f"        dim_strength = {float(style.get('inactive_dim', 0))},",
        "        blur = {",
        f"            enabled = {str(_bool(style.get('blur_on'), True)).lower()},",
        f"            size = {int(style.get('blur_strength', 8))},",
        f"            passes = {int(style.get('blur_passes', 3))},",
        f"            noise = {float(style.get('blur_noise', 0.0117))},",
        f"            contrast = {float(style.get('blur_contrast', 0.8916))},",
        f"            brightness = {float(style.get('blur_brightness', 0.8172))},",
        f"            vibrancy = {float(style.get('blur_vibrancy', 0.1696))},",
        "            new_optimizations = true,",
        "            xray = false,",
        "        },",
        "        shadow = {",
        f"            enabled = {str(_bool(style.get('shadow_on'), True)).lower()},",
        f"            range = {int(style.get('shadow_radius', 20))},",
        f"            render_power = {int(style.get('shadow_render_power', 3))},",
        f"            offset = {json.dumps(str(style.get('shadow_offset', '0 0')))},",
        f"            color = {shadow_argb},",
        "        },",
        "    },",
        "})",
    ]

    output = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypr" / "generated" / "theme.lua"
    output.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".theme.lua.", dir=output.parent, text=True)
    tmp = Path(temporary)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, output)
    finally:
        tmp.unlink(missing_ok=True)


def wallgen_command() -> list[str] | None:
    found = shutil.which("wallgen")
    if found:
        return [found]
    sibling = Path(__file__).resolve().with_name("wallgen")
    if sibling.exists():
        return [str(sibling)]
    return None


def wallpaper(args: list[str]) -> int:
    command = wallgen_command()
    if not command:
        print("theme wallpaper: wallgen was not found. Re-run the themes installer.", file=sys.stderr)
        return 127
    forwarded = list(args)
    if forwarded and forwarded[0] in ("-l", "--list"):
        forwarded[0] = "list"
    proc = subprocess.run(command + ["semantic"] + forwarded)
    if proc.returncode != 0:
        return proc.returncode
    changes_selection = bool(forwarded) and (
        forwarded[0] in {"use", "none"}
        or (forwarded[0] == "import" and "--no-use" not in forwarded)
    )
    if changes_selection:
        current = theme_runtime.active_theme()
        if current:
            try:
                _sync_hypr_lua(current)
                theme_runtime.apply_theme(current)
            except Exception as exc:
                print(f"theme wallpaper: imported/selected, but live apply failed: {exc}", file=sys.stderr)
                return 1
    return 0


def _enable_live_preview_by_default() -> None:
    """Make Theme Studio edits reach the desktop immediately.

    ThemeEditor intentionally gates preview callbacks behind its
    ``desktop_preview`` flag. The TUI presents itself as a live editor, but new
    editor sessions currently start with that flag disabled, so mutations only
    update the in-memory draft. Enable it before importing ``theme_tui`` so
    every editor constructed by the UI previews changes and can still restore
    the original theme through the existing cancel/disable callbacks.
    """
    import theme_editor

    original_post_init = theme_editor.ThemeEditor.__post_init__
    if getattr(original_post_init, "_theme_live_preview_default", False):
        return

    def post_init_with_preview(editor) -> None:
        original_post_init(editor)
        editor.desktop_preview = True

    post_init_with_preview._theme_live_preview_default = True
    theme_editor.ThemeEditor.__post_init__ = post_init_with_preview

    original_from_data = theme_editor.ThemeEditor.from_data.__func__

    def from_data_with_preview(cls, *args, **kwargs):
        editor = original_from_data(cls, *args, **kwargs)
        editor.desktop_preview = True
        return editor

    theme_editor.ThemeEditor.from_data = classmethod(from_data_with_preview)


def launch(name: str | None = None) -> int:
    if name:
        os.environ["THEME_STUDIO_THEME"] = name
    try:
        _enable_live_preview_by_default()
        from theme_tui import launch as launch_tui
        launch_tui()
        return 0
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"theme: Theme Studio could not start: {exc}", file=sys.stderr)
        print("Falling back to the classic picker.", file=sys.stderr)
        return run_legacy([])


def validate(name: str | None) -> int:
    target = name or theme_runtime.active_theme()
    if not target:
        print("theme validate: no active theme", file=sys.stderr)
        return 2
    try:
        theme = theme_runtime.load_theme(target)
    except Exception as exc:
        print(f"theme validate: {exc}", file=sys.stderr)
        return 2
    issues = validate_theme(theme)
    errors, warnings = validation_summary(issues)
    print(f"{target}: {errors} error(s), {warnings} suggestion(s)")
    for issue in issues:
        icon = "✗" if issue["level"] == "error" else "!"
        print(f"{icon} {issue['path']}: {issue['message']}")
    return 1 if errors else 0


def _active_theme_data() -> tuple[str | None, dict | None]:
    name = theme_runtime.active_theme()
    if not name:
        return None, None
    try:
        return name, theme_runtime.load_theme(name)
    except Exception:
        return name, None


def _publish_ui_style(name: str, theme: dict) -> None:
    try:
        theme_ui.publish(theme, name)
    except Exception as exc:
        print(f"theme: UI-style warning: {exc}", file=sys.stderr)


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return launch()
    if args[0] in ("-h", "--help", "help"):
        print(usage())
        return 0
    if args[0] in ("studio", "recover"):
        return launch()
    if args[0] == "edit":
        return launch(args[1] if len(args) > 1 else theme_runtime.active_theme())
    if args[0] == "validate":
        return validate(args[1] if len(args) > 1 else None)
    if args[0] == "legacy":
        return run_legacy(args[1:])
    if args[0] == "wallpaper":
        return wallpaper(args[1:])
    if args[0] == "ui":
        name, theme = _active_theme_data()
        try:
            return theme_ui.command(args[1:], theme, name)
        except Exception as exc:
            print(f"theme ui: {exc}", file=sys.stderr)
            return 2

    passthrough = {"shape", "texture", "anim", "effects", "homepage", "font", "starship", "-l", "--list"}
    if args[0] in passthrough or args[0].startswith("-"):
        code = run_legacy(args)
        if code == 0 and args[0] in {"shape", "texture", "anim", "effects", "homepage", "font"}:
            current = theme_runtime.active_theme()
            if current:
                try:
                    if args[0] in {"shape", "texture", "anim", "effects"}:
                        _sync_hypr_lua(current)
                    theme_runtime.apply_studio_overrides(current)
                except Exception as exc:
                    print(f"theme: Studio override warning: {exc}", file=sys.stderr)
        return code

    try:
        _sync_hypr_lua(args[0])
        result = theme_runtime.apply_theme(args[0])
    except Exception as exc:
        print(f"theme: {exc}", file=sys.stderr)
        return 1
    if result.get("legacy_message"):
        print(result["legacy_message"])
    _publish_ui_style(args[0], theme_runtime.load_theme(args[0]))
    print(f"Theme Studio overrides applied: {args[0]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
