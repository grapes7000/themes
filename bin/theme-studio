#!/usr/bin/env python3
"""Installed `theme` command: Qt Theme Studio plus backward-compatible CLI/TUI."""
from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

import theme_runtime
from theme_schema import validation_summary, validate_theme


def usage() -> str:
    return """theme — desktop theme studio

Interactive:
  theme                     Open Qt Theme Studio (TUI fallback)
  theme studio              Open Qt Theme Studio (TUI fallback)
  theme edit [name]         Open a theme in Qt Theme Studio
  theme qt [name]           Require the Qt frontend
  theme tui [name]          Open the existing terminal frontend
  theme qt-install          Install the managed PySide6 runtime

Compatible commands:
  theme <name>              Apply a theme and Studio component overrides
  theme --list              List themes
  theme shape ...           Existing shape commands
  theme texture ...         Existing texture commands
  theme anim ...            Existing animation commands
  theme homepage ...        Existing homepage commands
  theme font ...            Existing font commands
  theme wallpaper ...       Semantic wallpaper template commands

Wallpaper templates:
  theme wallpaper                   Show active template
  theme wallpaper --list            List templates
  theme wallpaper use <name>        Activate a template
  theme wallpaper none              Disable semantic recoloring
  theme wallpaper import IMAGE      Import and map a flat-color image

Studio utilities:
  theme validate [name]     Validate a theme
  theme recover             Open the existing TUI recovery flow
  theme legacy ...          Run the previous command directly
"""


def run_legacy(args: list[str]) -> int:
    command = theme_runtime.legacy_command()
    if not command:
        print("theme: legacy generator was not found. Re-run the themes installer.", file=sys.stderr)
        return 127
    return subprocess.call(command + args)


def wallgen_command() -> list[str] | None:
    found = shutil.which("wallgen")
    if found:
        return [found]
    sibling = Path(__file__).resolve().with_name("wallgen")
    if sibling.exists():
        return [str(sibling)]
    return None


def wallpaper(args: list[str]) -> int:
    command = wallgen_command()
    if not command:
        print("theme wallpaper: wallgen was not found. Re-run the themes installer.", file=sys.stderr)
        return 127
    forwarded = list(args)
    if forwarded and forwarded[0] in ("-l", "--list"):
        forwarded[0] = "list"
    proc = subprocess.run(command + ["semantic"] + forwarded)
    if proc.returncode != 0:
        return proc.returncode
    changes_selection = bool(forwarded) and (forwarded[0] in {"use", "none"} or (forwarded[0] == "import" and "--no-use" not in forwarded))
    if changes_selection:
        current = theme_runtime.active_theme()
        if current:
            try:
                theme_runtime.apply_theme(current)
            except Exception as exc:
                print(f"theme wallpaper: imported/selected, but live apply failed: {exc}", file=sys.stderr)
                return 1
    return 0


def _enable_live_preview_by_default() -> None:
    import theme_editor
    original_post_init = theme_editor.ThemeEditor.__post_init__
    if getattr(original_post_init, "_theme_live_preview_default", False):
        return
    def post_init_with_preview(editor) -> None:
        original_post_init(editor)
        editor.desktop_preview = True
    post_init_with_preview._theme_live_preview_default = True
    theme_editor.ThemeEditor.__post_init__ = post_init_with_preview
    original_from_data = theme_editor.ThemeEditor.from_data.__func__
    def from_data_with_preview(cls, *args, **kwargs):
        editor = original_from_data(cls, *args, **kwargs)
        editor.desktop_preview = True
        return editor
    theme_editor.ThemeEditor.from_data = classmethod(from_data_with_preview)


def launch_tui(name: str | None = None) -> int:
    if name:
        os.environ["THEME_STUDIO_THEME"] = name
    try:
        _enable_live_preview_by_default()
        from theme_tui import launch as launch_terminal
        launch_terminal()
        return 0
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"theme: terminal Theme Studio could not start: {exc}", file=sys.stderr)
        print("Falling back to the classic picker.", file=sys.stderr)
        return run_legacy([])


def _python_has_pyside(python: str) -> bool:
    try:
        proc = subprocess.run([python, "-c", "import PySide6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
        return proc.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def _qt_python() -> str | None:
    explicit = os.environ.get("THEME_STUDIO_QT_PYTHON")
    if explicit and _python_has_pyside(explicit):
        return explicit
    managed = Path(os.environ.get("THEME_STUDIO_QT_VENV", Path.home() / ".local" / "share" / "theme-studio" / "qt-venv")) / "bin" / "python"
    if managed.exists() and _python_has_pyside(str(managed)):
        return str(managed)
    if _python_has_pyside(sys.executable):
        return sys.executable
    return None


def launch_qt(name: str | None = None) -> int | None:
    python = _qt_python()
    if not python:
        return None
    app = Path(__file__).resolve().with_name("theme_qt_app.py")
    if not app.exists():
        print("theme: Qt frontend files are missing; re-run install.sh.", file=sys.stderr)
        return 2
    command = [python, str(app)]
    if name:
        command += ["--theme", name]
    try:
        return subprocess.call(command)
    except KeyboardInterrupt:
        return 130


def launch(name: str | None = None, *, frontend: str = "auto") -> int:
    if frontend != "tui":
        code = launch_qt(name)
        if code is not None:
            if code == 0 or frontend == "qt":
                return code
            print(f"theme: Qt frontend exited with status {code}; using TUI fallback.", file=sys.stderr)
        elif frontend == "qt":
            print("theme: PySide6 is not available for Qt Theme Studio.", file=sys.stderr)
            print("Run: theme qt-install", file=sys.stderr)
            return 127
    return launch_tui(name)


def install_qt_runtime() -> int:
    helper = Path(__file__).resolve().with_name("theme-qt-install")
    if not helper.exists():
        print("theme qt-install: helper missing; re-run install.sh", file=sys.stderr)
        return 127
    return subprocess.call([str(helper)])


def validate(name: str | None) -> int:
    target = name or theme_runtime.active_theme()
    if not target:
        print("theme validate: no active theme", file=sys.stderr)
        return 2
    try:
        theme = theme_runtime.load_theme(target)
    except Exception as exc:
        print(f"theme validate: {exc}", file=sys.stderr)
        return 2
    issues = validate_theme(theme)
    errors, warnings = validation_summary(issues)
    print(f"{target}: {errors} error(s), {warnings} suggestion(s)")
    for issue in issues:
        icon = "✗" if issue["level"] == "error" else "!"
        print(f"{icon} {issue['path']}: {issue['message']}")
    return 1 if errors else 0


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return launch()
    if args[0] in ("-h", "--help", "help"):
        print(usage())
        return 0
    if args[0] == "studio":
        return launch()
    if args[0] == "recover":
        return launch(frontend="tui")
    if args[0] == "edit":
        return launch(args[1] if len(args) > 1 else theme_runtime.active_theme())
    if args[0] == "qt":
        return launch(args[1] if len(args) > 1 else theme_runtime.active_theme(), frontend="qt")
    if args[0] == "tui":
        return launch(args[1] if len(args) > 1 else theme_runtime.active_theme(), frontend="tui")
    if args[0] == "qt-install":
        return install_qt_runtime()
    if args[0] == "validate":
        return validate(args[1] if len(args) > 1 else None)
    if args[0] == "legacy":
        return run_legacy(args[1:])
    if args[0] == "wallpaper":
        return wallpaper(args[1:])
    passthrough = {"shape", "texture", "anim", "effects", "homepage", "font", "starship", "-l", "--list"}
    if args[0] in passthrough or args[0].startswith("-"):
        code = run_legacy(args)
        if code == 0 and args[0] in {"shape", "texture", "anim", "effects", "homepage", "font"}:
            current = theme_runtime.active_theme()
            if current:
                try:
                    theme_runtime.apply_studio_overrides(current)
                except Exception as exc:
                    print(f"theme: Studio override warning: {exc}", file=sys.stderr)
        return code
    try:
        result = theme_runtime.apply_theme(args[0])
    except Exception as exc:
        print(f"theme: {exc}", file=sys.stderr)
        return 1
    if result.get("legacy_message"):
        print(result["legacy_message"])
    print(f"Theme Studio overrides applied: {args[0]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
