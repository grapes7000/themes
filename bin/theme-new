#!/usr/bin/env python3
"""theme-new — create and edit a new theme.

    theme-new <name>              # scaffold from catppuccin_mocha
    theme-new <name> --from nord  # scaffold from nord
    theme-new <name> --edit       # open in $EDITOR after scaffolding

Writes ~/.config/hypr/themes/<name>.json with an editable palette + style.
After editing, run `theme <name>` to apply it live.
"""
import json, os, sys, subprocess, shutil

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CFG, "hypr", "themes")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__); return

    name = args[0]
    base = "catppuccin_mocha"
    edit = False

    for i, arg in enumerate(args[1:], 1):
        if arg == "--from" and i < len(args) - 1:
            base = args[i + 1]
        elif arg == "--edit":
            edit = True

    # check name not already taken
    path = os.path.join(THEME_DIR, name + ".json")
    if os.path.exists(path):
        sys.exit(f"theme-new: '{name}' already exists. Edit it with: $EDITOR {path}")

    # load base theme
    base_path = os.path.join(THEME_DIR, base + ".json")
    if not os.path.exists(base_path):
        sys.exit(f"theme-new: base theme '{base}' not found. Try: theme --list")

    t = json.load(open(base_path))
    t["name"] = name

    # write new theme
    with open(path, "w") as f:
        json.dump(t, f, indent=2)
    print(f"created: {path}")

    if edit:
        ed = os.environ.get("EDITOR", "nano")
        subprocess.run([ed, path])
        print(f"hint: run `theme {name}` to apply it")
    else:
        print(f"edit it: $EDITOR {path}")
        print(f"apply it: theme {name}")


if __name__ == "__main__":
    main()
